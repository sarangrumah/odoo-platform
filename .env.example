# ============================================================
# Odoo 19 Platform — environment template
# Copy to .env and fill in all REQUIRED values before `make up`.
# Entrypoint will fail-fast on values containing the literal `changeme`.
# ============================================================

# ----- Compose project -----
COMPOSE_PROJECT_NAME=odoo19-platform

# ----- Ports (override jika bentrok dengan service lain di host) -----
ODOO_HTTP_PORT=18069
ODOO_LONGPOLL_PORT=18072
POSTGRES_PORT=15432
REDIS_PORT=16379
AI_GATEWAY_PORT=18080
PREDICTOR_PORT=18090
TENANT_ORCHESTRATOR_PORT=18091
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
LOKI_PORT=13100
ALERTMANAGER_PORT=19093
PGADMIN_PORT=15050
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025
NGINX_HTTP_PORT=18000
NGINX_HTTPS_PORT=18443
OLLAMA_PORT=11434

# ----- Secrets (WAJIB diganti — entrypoint fail-fast jika ada `changeme`) -----
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme-min-16-characters-required
POSTGRES_DB=postgres
ODOO_ADMIN_PASSWD=changeme-odoo-master-password
REDIS_PASSWORD=changeme-redis-pass-min-16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme-pgadmin
GATEWAY_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-32
CORETAX_SERTEL_MASTER_KEY=changeme-fernet-key-44-chars-base64urlsafe

# ----- Retail import mailbox (custom_retail_import) -----
# IMAP password for the account that receives the nightly X-center reports.
# Optional: leave empty unless a retail.import.mailbox record is active.
LEVIS_MAIL_PASSWORD=

# ----- Baileys WhatsApp sidecar (custom_whatsapp provider=baileys) -----
# Same secret is set on each whatsapp.account record (baileys_shared_secret)
# so the sidecar authenticates Odoo's outbound calls and Odoo verifies HMAC
# on the sidecar's webhook callbacks.
BAILEYS_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-32
BAILEYS_PORT=18088
# Where the sidecar POSTs inbound + delivery events. Default targets the
# internal Odoo service URL. In multi-tenant overlays, override to the
# per-tenant odoo-mgmt URL.
BAILEYS_ODOO_WEBHOOK_BASE=http://odoo:8069

# ----- FTPS drop (custom_retail_import local-directory feed) -----
# Partner uploads source files over explicit FTPS into ./data/data_levis/data;
# Odoo reads them from /mnt/data_levis/data and moves processed files to
# /mnt/data_levis/archive with a YYYYMMDD_HHMMSS_ prefix.
FTPS_USER=levis
FTPS_PASS=                      # WAJIB: set a strong password (>=16 chars)
FTPS_PORT=21
FTPS_PASSIVE_MIN=30000          # passive-mode port range (min); also published by Docker
FTPS_PASSIVE_MAX=30009          # passive-mode port range (max)
FTPS_PUBLICHOST=127.0.0.1       # public IP/host advertised for passive mode (set in prod)

# ----- Gentle Woman storefront (Next.js headless, custom_storefront_api) -----
# Customer-facing port for the storefront container.
STOREFRONT_PORT=18100
# Tenant DB + Host header the BFF uses so Odoo's dbfilter resolves the tenant.
STOREFRONT_TENANT_DB=gentle_woman
STOREFRONT_TENANT_HOST=gentle_woman.platform.localhost
# Internal Odoo URL the BFF calls (server-to-server, never exposed).
STOREFRONT_ODOO_BASE_URL=http://odoo:8069
# Browser-reachable Odoo origin for product images (/web/image/...).
STOREFRONT_PUBLIC_ODOO_URL=https://gentle_woman.platform.localhost
# MUST equal Odoo's ir.config_parameter custom_core.secure_endpoint.storefront.secret
STOREFRONT_HMAC_SECRET=changeme-generate-with-openssl-rand-hex-32
STOREFRONT_SITE_NAME=Gentle Woman
STOREFRONT_CURRENCY=IDR

# ----- Tenant orchestrator (multi-tenant lifecycle) -----
ORCHESTRATOR_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-32
# Postgres role used by orchestrator (created by 04-tenant-registry-schema.sql).
# Rotate this from the SQL default via `ALTER ROLE tenant_orchestrator PASSWORD '...';`
# at first boot (idempotent helper in Makefile target `rotate-orchestrator-pwd`).
PG_ORCHESTRATOR_PASSWORD=changeme-min-16-chars-orchestrator
# Master KMS wrapping key (Fernet 32-byte URL-safe base64 — 44 chars).
# Generate: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
MASTER_WRAPPING_KEY=changeme-fernet-44-chars-base64urlsafe-PADDED=
# Enable scheduled backups (set false to run orchestrator API-only without cron)
ENABLE_BACKUP_SCHEDULER=true

# ----- MinIO (S3-compatible backup storage) -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-min-8-chars
MINIO_DEFAULT_BUCKETS=platform-backups

# ----- AI providers -----
AI_PROVIDER=anthropic                          # anthropic | openai | ollama
AI_MODEL_DEFAULT=claude-sonnet-4-6
AI_MODEL_QUALITY=claude-opus-4-7
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_DEFAULT=llama3.2

# ----- Odoo runtime -----
WORKERS=0                                      # dev=0, prod>=4
MAX_CRON_THREADS=2
LIST_DB=true                                   # prod=false
# Multitenant overlay pins the public Odoo to LIST_DB=False. Set this to True to
# open /web/database/manager there; the dbfilter still scopes the visible list to
# the requested hostname, so use the odoo-mgmt instance for cross-tenant ops.
ODOO_PUBLIC_LIST_DB=False
WITHOUT_DEMO=                                  # prod=all
LIMIT_TIME_CPU=600
LIMIT_TIME_REAL=1200
LIMIT_MEMORY_SOFT=2147483648
LIMIT_MEMORY_HARD=2684354560
LOG_LEVEL=info                                 # debug|info|warn|error|critical
PROXY_MODE=True
DBFILTER=^.*$
SERVER_WIDE_MODULES=base,web,queue_job

# ----- Network policy -----
EXPOSE_DB=false                                # true = postgres listen di host (dev only)
EXPOSE_REDIS=false

# ----- Observability -----
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=336h                            # 14 days
PREDICTOR_INTERVAL_HOURS=6
ALERTMANAGER_WEBHOOK_URL=                      # opsional: Slack/Discord webhook
ALERTMANAGER_EMAIL_TO=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ----- Predictor / capacity planning -----
HOST_CPU_CORES=8
HOST_RAM_GB=32
HOST_DISK_GB=500

# ----- TLS (prod) -----
TLS_CERT_PATH=./nginx/certs/server.crt
TLS_KEY_PATH=./nginx/certs/server.key

# ----- TLS / ACME (Caddy overlay: docker-compose.tls-acme.yml) -----
# Public DNS name terminating at this host. Leave default for local trials
# (Caddy will use its internal CA and issue a self-signed cert).
DOMAIN=localhost.localdomain
# Contact email for Let's Encrypt. Empty => Caddy local CA only.
ACME_EMAIL=
# Optional custom ACME directory (e.g. for staging or ZeroSSL/Buypass).
# Empty => Let's Encrypt production. Use the staging Caddyfile variant
# (caddy/Caddyfile.staging) for safe end-to-end testing.
ACME_CA_DIR=
# Host-side ports Caddy binds to (80/443 are the ACME-required defaults).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ----- Backup (postgres-backup-s3 sidecar) -----
# S3 / S3-compatible object storage. Leave S3_ENDPOINT empty for AWS S3.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-southeast-3
S3_PREFIX=odoo19-platform/postgres
S3_ENDPOINT=
# Backup retention (days) and cron schedule (standard 5-field cron).
BACKUP_KEEP_DAYS=30
SCHEDULE=@daily

# ----- UAT / Demo friendliness -----
# When true, the tenant-orchestrator returns stub responses for SSH-dependent
# VPS actions (register/health/decommission). Leave false in production.
PLATFORM_DEMO_MODE=false
# Optional integrations — blank means "degrade gracefully" (BRD analysis
# falls back to a stub; intake captcha is bypassed).
ANTHROPIC_API_KEY=
TURNSTILE_SECRET=
# HashiCorp Vault for vault:// ssh credential refs (optional).
VAULT_ADDR=
VAULT_TOKEN=

# ---- Login gateway (front-door tenant chooser, replaces Odoo's DB selector) ----
# The vertical/environment -> database map is login-gateway/config/tenants.json,
# NOT an env var: it is an allow-list, and it must be reviewable in git.
LOGIN_GATEWAY_PORT=18120
LOGIN_GATEWAY_ODOO_URL=http://odoo-front:8069
# HTTP workers for odoo-front, the multi-DB instance every front-door login now
# lands on. Unlike odoo-mgmt (WORKERS=0, admin only) this one carries real users.
ODOO_FRONT_WORKERS=4

# ---- VAS PMO (Next.js headless UI for the Product Owner - VAS team) ----
VAS_PMO_PORT=18110
VAS_PMO_TENANT_DB=rnd_vas_pmo
VAS_PMO_TENANT_HOST=
VAS_PMO_ODOO_BASE_URL=https://nginx
# Shared BOTH ways: Odoo outbox -> /api/notify AND BFF -> /vaspmo/api/hmac/*.
# Must match ir.config_parameter custom_core.secure_endpoint.vaspmo.secret
VAS_PMO_HMAC_SECRET=
VAS_PMO_JWT_SECRET=
VAS_PMO_MAIL_FROM=VAS PMO <no-reply@vas-pmo.internal>
VAS_PMO_BAILEYS_URL=http://baileys:8088
# WhatsApp transport: wahub (primary) with the platform baileys gateway as fallback
WA_PROVIDER=wahub
WAHUB_API_URL=
WAHUB_APP_ID=
WAHUB_APP_SECRET=
BAILEYS_API_KEY=
# Safety valve during onboarding: redirect every notification to one tester
NOTIFICATION_TEST_MODE=false
NOTIFICATION_TEST_PHONE=
NOTIFICATION_TEST_EMAIL=
