# The sidecar that answers what the catalogue cannot place.
#
# It holds NO database credentials by design: every figure is fetched back
# through the cockpit's HMAC-signed skill endpoint, which only accepts a skill
# name and validated arguments.

# Where to call back for skill results. Must include the cockpit's basePath.
COCKPIT_URL=http://sales-cockpit:8080/cockpit
# Shared with the cockpit's COCKPIT_AGENT_SECRET; 32+ characters.
COCKPIT_AGENT_SECRET=

ANTHROPIC_API_KEY=
COCKPIT_AGENT_MODEL=claude-opus-5
# low | medium | high — routing one sentence onto one catalogued question.
COCKPIT_AGENT_EFFORT=low

PORT=8080
