# ============================================================
# PPOB / PPS node — environment
# Copy to .env di root repo pada VPS PPOB, lalu isi semua nilai placeholder.
# Entrypoint Odoo fail-fast kalau nilai placeholder belum diganti.
#
# Skenario: VPS 192.168.3.185 DIAMBIL ALIH. Stack lama ("OdooHub"
# Odoo 18 CE + Next.js + FastAPI, Postgres 5433) diarsipkan lalu
# dimatikan oleh takeover.sh SEBELUM bootstrap.sh jalan, sehingga
# node PPOB bisa memakai port standar.
# ============================================================

COMPOSE_PROJECT_NAME=ppob-node

# ----- Ports -----
# Dipakai setelah takeover.sh mematikan stack lama. Kalau stack lama
# masih hidup, bootstrap.sh akan berhenti karena port bentrok.
ODOO_HTTP_PORT=8069        # port standar — VPS diambil alih, stack lama dimatikan
ODOO_LONGPOLL_PORT=8072
POSTGRES_PORT=5432          # 127.0.0.1 saja
REDIS_PORT=6379             # 127.0.0.1 saja

# ----- Identitas database -----
# Node ini single-tenant: DBFILTER dikunci ke satu nama DB.
PPOB_DB_NAME=ppob
LIST_DB=False
DBFILTER=^ppob$

# ----- Secrets (WAJIB diganti) -----
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme-min-16-characters-required
POSTGRES_DB=postgres
PG_ORCHESTRATOR_PASSWORD=changeme-min-16-characters-required
ODOO_ADMIN_PASSWD=changeme-odoo-master-password
REDIS_PASSWORD=changeme-redis-pass-min-16
GATEWAY_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-32
ORCHESTRATOR_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-32
CORETAX_SERTEL_MASTER_KEY=changeme-fernet-key-44-chars-base64urlsafe

# ----- Tuning Odoo -----
WORKERS=4
MAX_CRON_THREADS=2
WITHOUT_DEMO=all
PROXY_MODE=False
LOG_LEVEL=info

# ----- Integrasi PPOB (isi saat sudah ada kredensial) -----
# Oracle EVShop H2H (custom_ppob_oracle_bridge). Modul ini TIDAK dipasang
# secara default: 3 cron-nya jalan tiap menit dan akan error terus tanpa
# koneksi Oracle. Set ke 1 hanya kalau DSN di bawah sudah benar.
PPOB_INSTALL_ORACLE_BRIDGE=0
PPOB_ORACLE_DSN=
PPOB_ORACLE_USER=
PPOB_ORACLE_PASSWORD=
