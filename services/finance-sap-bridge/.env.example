# Odoo target
ODOO_BASE_URL=http://odoo:8069

# HMAC secrets (must match the Odoo side — see README)
#   Odoo -> bridge : equals Odoo ir.config_parameter custom_finance_portal_sap.sap_bridge_secret
BRIDGE_INBOUND_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxx
#   bridge -> Odoo : equals Odoo ir.config_parameter custom_core.secure_endpoint.finance_sap.secret
BRIDGE_OUTBOUND_SECRET=change-me-min-32-chars-yyyyyyyyyyyyyy

# Kafka (leave KAFKA_BOOTSTRAP empty to run in mock mode)
KAFKA_BOOTSTRAP=
KAFKA_GROUP_ID=finance-sap-bridge
KAFKA_TOPIC_PREFIX_TO_SAP=portal.to-sap
KAFKA_TOPIC_FROM_SAP=sap.to-portal.status
KAFKA_TOPIC_FROM_HRIS=hris.to-portal.travel

HMAC_DRIFT_SECONDS=300
LOG_LEVEL=INFO
