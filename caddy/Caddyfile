# ============================================================
# Caddyfile — TLS terminator in front of nginx
# Env-driven:
#   {$DOMAIN}      site name (default: localhost.localdomain)
#   {$ACME_EMAIL}  contact for LE (empty => local internal CA)
#   {$ACME_CA_DIR} ACME directory URL (empty => LE production)
#
# Caddy listens on 80 + 443 and proxies cleartext to the internal
# `nginx:80` service, which still enforces rate-limit/WAF rules.
# ============================================================

{
	# Email used only for real ACME issuance (Let's Encrypt). With `tls internal`
	# below it is ignored, but Caddyfile still requires a valid token, so fall
	# back to a placeholder when ACME_EMAIL is empty.
	email {$ACME_EMAIL:admin@localhost}

	# Optional custom ACME CA directory (e.g. Buypass, ZeroSSL).
	# Leave empty for Let's Encrypt production (Caddy's default).
	# acme_ca {$ACME_CA_DIR}

	# Admin API bound to localhost inside the container — used by healthcheck.
	admin 0.0.0.0:2019

	# Fall back to this site name when the client sends no SNI (clients
	# connecting to a bare IP per RFC 6066 don't include SNI, which would
	# otherwise cause Caddy to abort the handshake).
	default_sni {$DOMAIN:localhost.localdomain}
}

# ============================================================
# Shared route table for the front-door hosts.
#
# Two hostnames serve exactly the same application surface: the bare-IP
# host (legacy, being retired) and eal-hub.erajaya.com (the real domain,
# fronted by Cloudflare). Keeping the routes in one snippet means the two
# cannot drift apart, and retiring the IP host later is a matter of
# deleting its site block rather than re-deriving what it used to serve.
#
# TLS is deliberately NOT part of the snippet: the two hosts terminate
# differently (internal CA vs the Sectigo wildcard), so each site block
# states its own.
# ============================================================
(front_door) {
	encode zstd gzip

	# Erajaya Odoo Hub portal (landing + admin console) is mounted at /portal/*.
	# The portal is a thin SPA + BFF; the BFF in turn signs HMAC calls to the
	# tenant-orchestrator on the internal network.
	#
	# The SPA's index.html references absolute paths (`/assets/...`) and its
	# XHRs call absolute `/api/...`. Neither prefix is used by Odoo, so we
	# route them straight to hub-portal without stripping. The `/portal/*`
	# entry serves index.html for the SPA boot; client-side routing then
	# keeps the URL under /portal/.
	handle /assets/* {
		reverse_proxy hub-portal:8080
	}
	# --- MDM product-master API ------------------------------------------
	# Both blocks must stay ahead of `handle /api/*` below, which sends
	# everything under /api to hub-portal. Without them the MDM routes never
	# reach Odoo at all.
	#
	# UAT and production share this host, this certificate and this port, so
	# the path prefix is the only thing telling them apart. That is why the
	# production path is claimed here and answered explicitly rather than left
	# to fall through: a caller pointed at the wrong one gets a clear refusal
	# instead of hub-portal's "Cannot GET", and the cutover cannot silently
	# repoint a URL that Mulesoft is already using.
	#
	# There was a /api/mdm/uat/* block here proxying to mdm-test-odoo, a
	# throwaway container pinned to tst_mdm_levis. Removed 2026-08-04: the
	# container had been crash-looping since 31-Jul (6048 restarts, never once
	# started) and both it and the tst_mdm_levis database are now gone. A route
	# to a dead upstream answers 502, which reads like an outage of something
	# that exists.
	#
	# Neither environment is deployed, so the path is claimed and refused
	# explicitly rather than left to fall through to hub-portal's "Cannot GET".
	# When custom_retail_import_api is installed, replace this with a
	# reverse_proxy to nginx (copy the transport block from the catch-all at the
	# end of this site). Note the database still has to be resolved
	# deterministically: this host serves every tenant DB, and an API call
	# carries no session to choose one -- see the X-Odoo-Database header used by
	# the baileys webhook for the mechanism.
	handle /api/mdm/* {
		header Content-Type application/json
		respond `{"status":"error","data":null,"error":{"code":"NOT_DEPLOYED","message":"The MDM endpoint is not deployed."}}` 404
	}

	handle /api/* {
		reverse_proxy hub-portal:8080
	}
	handle_path /portal/* {
		reverse_proxy hub-portal:8080
	}
	# Same `redir * ...` form as the tenant chooser below — without the `*` this
	# block answered 404 instead of redirecting, which it did until 2026-08-05.
	handle /portal {
		redir * /portal/ 308
	}

	# VAS PMO headless UI. Next.js is built with basePath=/vaspmo, so it expects to see
	# the prefix itself — `handle`, not `handle_path`, exactly like File Browser below.
	# There is no spare hostname to give it: DOMAIN here is a bare IP.
	handle /vaspmo* {
		reverse_proxy vas-pmo:8080
	}

	# File Browser web UI for the /srv/sftp-share/files drop zone. The
	# container runs with base path `-b /files`, so keep the prefix (use
	# `handle`, not `handle_path`). Login-gated; used for client file hand-off.
	handle /files* {
		reverse_proxy odoo19-platform-filebrowser:80
	}

	# --- Tenant chooser -----------------------------------------------------
	# The root of both front-door hosts used to be Odoo's database selector,
	# i.e. a public list of every client's database plus the database manager.
	# It is now the login gateway: pick a vertical and an environment, and the
	# gateway resolves that to a database SERVER-SIDE, bootstraps an Odoo
	# session already pinned to it, and forwards the browser to /web/login.
	# See login-gateway/README.md for why it has to work that way.
	#
	# Next.js is built with basePath=/signin, so it expects to see the prefix
	# itself — `handle`, not `handle_path`, same as /vaspmo and /files above.
	# `redir * <to> <code>`, NOT `redir <to> <code>`: Caddy reads a leading-slash
	# first argument as a PATH MATCHER, so `redir /signin/ 302` compiles to "when
	# the path is /signin/, redirect to the literal URI `302`" — a route that
	# never fires and, if it did, would send a Location header of "302". The `*`
	# says "match anything inside this handle block", which is what is meant.
	handle / {
		redir * /signin/ 302
	}
	handle /signin* {
		reverse_proxy login-gateway:8080
	}

	# Odoo redirects any request it cannot resolve a database for to
	# /web/database/selector. That is precisely "this session has no tenant
	# yet", so point it at the chooser instead of at a 404. Session expiry and
	# logout both land here, which is what makes the flow self-healing.
	handle /web/database/selector* {
		redir * /signin/ 302
	}

	# Everything else under /web/database/ is the database manager: create,
	# drop, backup, restore, duplicate. It has no business on a public host.
	# odoo-front runs LIST_DB=False so Odoo refuses these itself; this block is
	# the belt to that pair of braces. Admins reach the real manager through
	# odoo-mgmt on 127.0.0.1:18079 over an SSH tunnel.
	handle /web/database/* {
		respond "Not available" 403
	}

	# All remaining traffic on the front-door hosts goes to odoo-front.
	#
	# Why not the public odoo: it runs dbfilter = ^%d$ (tenant isolation — a
	# hostname may only reach the DB of the same name). Neither front-door host
	# is named after a database — one is a bare IP, the other is
	# eal-hub.erajaya.com — so the public instance answers EVERY path on them
	# with 303 -> /web/database/selector. Nothing can be logged into through it.
	#
	# Why not odoo-mgmt, which this used to point at: it can serve every DB,
	# but only because it also runs LIST_DB=True — it hands the database
	# manager and the full tenant list to anyone who asks. odoo-front is the
	# same dbfilter WITHOUT the manager (docker-compose.multitenant.yml), and
	# with real HTTP workers; mgmt runs WORKERS=0 and was never sized for
	# end-user traffic. Per-tenant routing is untouched: tenants reach the
	# public odoo by their own hostname, never through the front door.
	#
	# NOTE: this bypasses the internal nginx hop, so the rate-limit and the
	# extra security headers defined in nginx/conf.d/odoo.conf do not apply to
	# this host.
	reverse_proxy odoo-front:8069 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 720s
			write_timeout 720s
			dial_timeout 10s
		}
	}

	# Caddy-level access log (JSON) shipped to stdout for Loki/Promtail.
	log {
		output stdout
		format json
		level INFO
	}
}

# ============================================================
# Front door #1 — eal-hub.erajaya.com (public, via Cloudflare)
# ============================================================
# DNS for this name is proxied by Cloudflare (orange cloud), so the
# certificate a browser sees belongs to Cloudflare, not to us. The cert
# configured below is the ORIGIN certificate: the one Cloudflare itself
# validates on the CF -> origin hop. Without it Caddy has no site matching
# SNI `eal-hub.erajaya.com`, aborts the handshake, and Cloudflare answers
# HTTP 525 (SSL handshake failed) to every visitor.
#
# The Sectigo wildcard is used rather than ACME because HTTP-01/TLS-ALPN-01
# cannot complete through a proxying Cloudflare — the challenge terminates at
# the edge, not here. A publicly-trusted cert also means Cloudflare's SSL mode
# can stay on "Full (strict)".
#
# Cert files live under the bind-mounted ./data/caddy/data volume so they can
# be replaced at renewal without recreating the container (see
# docs/runbooks/tls-renewal.md). fullchain.pem must carry the leaf FIRST and
# then the Sectigo intermediates; a leaf-only file makes Cloudflare's strict
# mode fail even though a browser might accept it.
eal-hub.erajaya.com {
	tls /data/certs/star.erajaya.com/fullchain.pem /data/certs/star.erajaya.com/privkey.pem

	import front_door
}

# ============================================================
# Front door #2 — bare-IP host (LEGACY, to be retired)
# ============================================================
# Kept alive during the domain cutover so anything still pointed at
# https://{$DOMAIN}/ keeps working, and so there is a way in that does not
# depend on Cloudflare. `tls internal` means a browser warning; that is
# accepted for the transition. To retire it, delete this block — the routes
# themselves live in the (front_door) snippet above and are unaffected.
{$DOMAIN:localhost.localdomain} {
	tls internal

	import front_door
}

# ============================================================
# Gentle Woman headless storefront — dedicated HTTPS port 8443.
# Served over the same trusted IP/DOMAIN cert as :443 so it works under
# HSTS (browser forces HTTPS on the host; the storefront container itself
# only speaks plain HTTP on :8080). Reach it at https://<DOMAIN>:8443/.
# ============================================================
{$DOMAIN:localhost.localdomain}:8443 {
	encode zstd gzip
	tls internal

	reverse_proxy storefront:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
		level INFO
	}
}
