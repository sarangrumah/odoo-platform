# ---- Runtime (server-side only unless prefixed NEXT_PUBLIC_) ----
PORT=8080
NODE_ENV=production

# Internal Odoo base URL the BFF talks to (never exposed to the browser).
ODOO_BASE_URL=http://odoo:8069
# Tenant database name. The BFF sets a Host header so Odoo's dbfilter (^%d$)
# resolves this tenant. Override ODOO_TENANT_HOST if your base domain differs.
ODOO_TENANT_DB=gentle_woman
ODOO_TENANT_HOST=gentle_woman.platform.localhost

# HMAC shared secret for server-to-server admin calls — MUST equal Odoo's
# ir.config_parameter custom_core.secure_endpoint.storefront.secret
STOREFRONT_HMAC_SECRET=changeme-generate-with-openssl-rand-hex-32

# ---- Public (exposed to the browser) ----
# Browser-reachable Odoo origin used to render /web/image/... product images.
NEXT_PUBLIC_ODOO_PUBLIC_URL=https://gentle_woman.platform.localhost
NEXT_PUBLIC_SITE_NAME=Gentlewoman
NEXT_PUBLIC_CURRENCY=IDR
