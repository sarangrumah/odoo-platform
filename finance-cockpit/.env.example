# Copy to .env.local for local development. Never commit the real password.
#
# The role is created by sql/001_finance_ro_role.sql and can only reach
# prd_levis_begbal, only for SELECT, and only on the tables listed there.
# It is a different role from the sales cockpit's cockpit_ro on purpose.

FINANCE_DB_HOST=postgres
FINANCE_DB_PORT=5432
FINANCE_DB_NAME=prd_levis_begbal
FINANCE_DB_USER=finance_ro
FINANCE_DB_PASSWORD=
FINANCE_DB_POOL_MAX=8

# --- Authentication ---
# Credentials are checked by Odoo. It must be odoo-front: the public `odoo` runs
# dbfilter ^%d$ and answers "Database not found" for this tenant.
FINANCE_ODOO_URL=http://odoo-front:8069
# Signs the session cookie. At least 32 characters, or the app refuses to start
# a session — a default here would let anyone forge one.
FINANCE_SESSION_SECRET=
FINANCE_SESSION_TTL=43200

# --- Parity test only ---------------------------------------------------------
# tests/parity.smoke.ts logs in to Odoo as an admin to call the real reports and
# compare their totals with the dashboard's. Nothing else in the app reads these,
# and they belong in .env.local, never in the container's environment.
FINANCE_PARITY_LOGIN=
FINANCE_PARITY_PASSWORD=
