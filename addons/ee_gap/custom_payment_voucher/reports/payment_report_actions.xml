<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Two branded documents on account.payment:
        * Payment Voucher  -> vendor / outbound payments (Send Money)
        * Payment Receipt  -> customer / inbound payments (Receive Money)
      Both are bound to the account.payment Print menu; the body adapts its
      wording to the payment direction.
    -->
    <record id="action_report_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_payment_voucher.report_payment_voucher</field>
        <field name="report_file">custom_payment_voucher.report_payment_voucher</field>
        <field name="print_report_name">'Payment Voucher - %s' % (object.name or 'Draft')</field>
        <field name="paperformat_id" ref="paperformat_payment_voucher_landscape"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_payment_receipt" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_payment_voucher.report_payment_receipt</field>
        <field name="report_file">custom_payment_voucher.report_payment_receipt</field>
        <field name="print_report_name">'Payment Receipt - %s' % (object.name or 'Draft')</field>
        <field name="paperformat_id" ref="paperformat_payment_voucher_landscape"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
