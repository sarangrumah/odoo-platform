<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Extra payment fields. Note / Remark are informational and print on the
      voucher; Override Outstanding Account changes the POSTED GL of this one
      payment and is therefore placed next to the journal it overrides.
    -->
    <record id="view_account_payment_form_voucher_extra" model="ir.ui.view">
        <field name="name">account.payment.form.voucher.extra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="pv_override_outstanding_account_id" options="{'no_create': True}"/>
                <field name="pv_note"/>
                <field name="pv_remark"/>
            </field>
        </field>
    </record>
</odoo>
