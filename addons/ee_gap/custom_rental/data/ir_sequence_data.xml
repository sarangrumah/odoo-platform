<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- rental.order.create() calls next_by_code("rental.order") and falls back
         to the literal "RNT-???" when the sequence is missing — which made every
         rental order share that same name. This restores the sequence the code
         has always expected (the original data file was lost; this file was a
         placeholder generated by demo-bootstrap just to let the module install). -->
    <record id="seq_rental_order" model="ir.sequence">
        <field name="name">Rental Order</field>
        <field name="code">rental.order</field>
        <field name="prefix">RNT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
