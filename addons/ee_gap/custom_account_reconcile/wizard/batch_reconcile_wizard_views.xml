<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_batch_reconcile_wizard" model="ir.ui.view">
            <field name="name">custom.account.reconcile.batch.wizard.form</field>
            <field name="model">custom.account.reconcile.batch.wizard</field>
            <field name="arch" type="xml">
                <form string="Clearing Massal">
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="date_to"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="max_groups"/>
                            <field name="dry_run"/>
                            <field name="open_lines" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not dry_run">
                        Simulasi: tidak ada yang direkonsiliasi. Hilangkan centang
                        <b>Simulasi saja</b> untuk benar-benar menjalankannya.
                    </div>
                    <group string="Hasil" invisible="not result_note">
                        <group>
                            <field name="group_count" readonly="1"/>
                            <field name="matched_lines" readonly="1"/>
                        </group>
                        <group>
                            <field name="matched_amount" readonly="1"/>
                            <field name="remaining_lines" readonly="1"/>
                        </group>
                        <field name="result_note" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <footer>
                        <button name="action_run" type="object" string="Jalankan" class="btn-primary"/>
                        <button string="Tutup" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_batch_reconcile_wizard" model="ir.actions.act_window">
            <field name="name">Clearing Massal</field>
            <field name="res_model">custom.account.reconcile.batch.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_batch_reconcile"
                  name="Clearing Massal"
                  parent="custom_account_reconcile.menu_custom_reconciliation"
                  action="action_batch_reconcile_wizard"
                  sequence="25"
                  groups="account.group_account_manager"/>
    </data>
</odoo>
