<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             Signature vouchers. Two platform rules govern every template
             in this file:

             1. Self-contained wrapper — NO `web.html_container`. That layout
                triggers an asset callback wkhtmltopdf stalls on, turning a
                one-second print into a multi-minute hang.
             2. <style> and <meta> live INSIDE <main>. Odoo 19 keeps only the
                //main subtree of a rendered report and discards the rest, so
                a <head> stylesheet silently prints unstyled — which is what
                the 0.4.0 disbursement voucher did.
             ============================================================ -->
        <template id="voucher_styles">
            <meta charset="utf-8"/>
            <style>
                @page { margin: 14mm; }
                body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; }
                table { border-collapse: collapse; width: 100%; }
                td, th { padding: 4px 6px; }
                .box td, .box th { border: 1px solid #999; }
                .title { font-size: 20px; font-weight: bold; margin-bottom: 2px; }
                .subtitle { color: #555; margin-bottom: 10px; }
                .lbl { color: #555; width: 30%; }
                .text-end { text-align: right; }
                .sign td { text-align: center; padding-top: 48px; }
            </style>
        </template>

        <!-- ================= Disbursement (Bukti Pencairan) ================= -->
        <record id="action_report_disbursement_voucher" model="ir.actions.report">
            <field name="name">Disbursement Voucher</field>
            <field name="model">petty.cash.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_disbursement_voucher</field>
            <field name="report_file">custom_petty_cash.report_disbursement_voucher</field>
            <field name="binding_model_id" ref="model_petty_cash_request"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Bukti Pencairan - %s' % (object.name)</field>
        </record>

        <template id="report_disbursement_voucher">
            <html>
                <body>
                    <main>
                        <t t-call="custom_petty_cash.voucher_styles"/>
                        <t t-foreach="docs" t-as="doc">
                            <div class="page" style="page-break-after: always;">
                                <div class="title">Bukti Pencairan Uang Muka</div>
                                <div class="subtitle" t-esc="doc.company_id.name"/>
                                <table class="box">
                                    <tr><td class="lbl">Reference</td><td t-esc="doc.name"/></tr>
                                    <tr><td class="lbl">Type</td><td t-esc="doc.advance_type_id.name or ''"/></tr>
                                    <tr><td class="lbl">Employee</td><td t-esc="doc.employee_id.name"/></tr>
                                    <tr><td class="lbl">Operating Unit</td><td t-esc="doc.l10n_ou_analytic_id.name or ''"/></tr>
                                    <tr><td class="lbl">Request Date</td><td t-esc="doc.request_date"/></tr>
                                    <tr><td class="lbl">Realization Deadline</td><td t-esc="doc.realization_deadline or ''"/></tr>
                                    <tr><td class="lbl">Purpose</td><td t-esc="doc.purpose or ''"/></tr>
                                    <tr>
                                        <td class="lbl">Amount</td>
                                        <td>
                                            <span t-esc="doc.amount_requested"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                                <div t-if="doc.line_ids" style="margin-top:12px;">
                                    <strong>Detail Lines</strong>
                                    <table class="box" style="margin-top:4px;">
                                        <thead>
                                            <tr><th>Description</th><th>Account</th><th class="text-end">Amount</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="doc.line_ids" t-as="l">
                                                <td t-esc="l.name"/>
                                                <td t-esc="l.account_id.display_name or ''"/>
                                                <td class="text-end">
                                                    <span t-esc="l.amount"
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <table class="sign">
                                    <tr>
                                        <td>Requested by<br/><br/><br/>__________________</td>
                                        <td>Approved by<br/><br/><br/>__________________</td>
                                        <td>Received by<br/><br/><br/>__________________</td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                    </main>
                </body>
            </html>
        </template>

        <!-- ============ Realization (Bukti Pertanggungjawaban) ============ -->
        <record id="action_report_realization_voucher" model="ir.actions.report">
            <field name="name">Realization Voucher</field>
            <field name="model">petty.cash.realization</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_realization_voucher</field>
            <field name="report_file">custom_petty_cash.report_realization_voucher</field>
            <field name="binding_model_id" ref="model_petty_cash_realization"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Bukti Pertanggungjawaban - %s' % (object.name)</field>
        </record>

        <template id="report_realization_voucher">
            <html>
                <body>
                    <main>
                        <t t-call="custom_petty_cash.voucher_styles"/>
                        <t t-foreach="docs" t-as="doc">
                            <div class="page" style="page-break-after: always;">
                                <div class="title">Bukti Pertanggungjawaban Uang Muka</div>
                                <div class="subtitle" t-esc="doc.company_id.name"/>
                                <table class="box">
                                    <tr><td class="lbl">Reference</td><td t-esc="doc.name"/></tr>
                                    <tr><td class="lbl">Request</td><td t-esc="doc.request_id.name"/></tr>
                                    <tr><td class="lbl">Type</td><td t-esc="doc.advance_type_id.name or ''"/></tr>
                                    <tr><td class="lbl">Employee</td><td t-esc="doc.employee_id.name"/></tr>
                                    <tr><td class="lbl">Realization Date</td><td t-esc="doc.date"/></tr>
                                    <tr><td class="lbl">Operating Unit</td><td t-esc="doc.l10n_ou_analytic_id.name or ''"/></tr>
                                </table>

                                <table class="box" style="margin-top:12px;">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Description</th>
                                            <th>Vendor</th>
                                            <th>Account</th>
                                            <th class="text-end">Untaxed</th>
                                            <th class="text-end">Tax</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.line_ids" t-as="l">
                                            <td t-esc="dict(l._fields['line_type'].selection).get(l.line_type, '')"/>
                                            <td t-esc="l.name"/>
                                            <td t-esc="l.partner_id.display_name or ''"/>
                                            <td t-esc="l.account_id.display_name or ''"/>
                                            <td class="text-end">
                                                <span t-esc="l.price_subtotal"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="l.price_tax"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="l.price_total"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight:bold;">
                                            <td colspan="6">Total Realized</td>
                                            <td class="text-end">
                                                <span t-esc="doc.amount_total"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="6">Disbursed</td>
                                            <td class="text-end">
                                                <span t-esc="doc.request_id.amount_disbursed"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr style="font-weight:bold;">
                                            <td colspan="6">Outstanding (to return / to reimburse)</td>
                                            <td class="text-end">
                                                <span t-esc="doc.request_id.amount_outstanding"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <table class="sign">
                                    <tr>
                                        <td>Submitted by<br/><br/><br/>__________________</td>
                                        <td>Verified by<br/><br/><br/>__________________</td>
                                        <td>Approved by<br/><br/><br/>__________________</td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                    </main>
                </body>
            </html>
        </template>

        <!-- ========= Settlement (Bukti Pengembalian / Top-up) ========= -->
        <record id="action_report_settlement_voucher" model="ir.actions.report">
            <field name="name">Settlement Voucher</field>
            <field name="model">petty.cash.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_settlement_voucher</field>
            <field name="report_file">custom_petty_cash.report_settlement_voucher</field>
            <field name="binding_model_id" ref="model_petty_cash_request"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Bukti Penyelesaian - %s' % (object.name)</field>
        </record>

        <template id="report_settlement_voucher">
            <html>
                <body>
                    <main>
                        <t t-call="custom_petty_cash.voucher_styles"/>
                        <t t-foreach="docs" t-as="doc">
                            <div class="page" style="page-break-after: always;">
                                <div class="title">Bukti Penyelesaian Uang Muka</div>
                                <div class="subtitle" t-esc="doc.company_id.name"/>
                                <table class="box">
                                    <tr><td class="lbl">Reference</td><td t-esc="doc.name"/></tr>
                                    <tr><td class="lbl">Type</td><td t-esc="doc.advance_type_id.name or ''"/></tr>
                                    <tr><td class="lbl">Employee</td><td t-esc="doc.employee_id.name"/></tr>
                                    <tr><td class="lbl">Status</td>
                                        <td t-esc="dict(doc._fields['state'].selection).get(doc.state, '')"/></tr>
                                    <tr>
                                        <td class="lbl">Disbursed</td>
                                        <td><span t-esc="doc.amount_disbursed"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Realized</td>
                                        <td><span t-esc="doc.amount_realized"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Outstanding</td>
                                        <td><span t-esc="doc.amount_outstanding"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </table>

                                <div style="margin-top:12px;"><strong>Journal Entries</strong></div>
                                <table class="box" style="margin-top:4px;">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Entry</th>
                                            <th>Journal</th>
                                            <th>Reference</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.move_ids.sorted(key=lambda m: (m.date, m.id))" t-as="m">
                                            <td t-esc="m.date"/>
                                            <td t-esc="m.name"/>
                                            <td t-esc="m.journal_id.name"/>
                                            <td t-esc="m.ref or ''"/>
                                            <td t-esc="m.state"/>
                                        </tr>
                                    </tbody>
                                </table>

                                <table class="sign">
                                    <tr>
                                        <td>Returned / Received by<br/><br/><br/>__________________</td>
                                        <td>Cashier<br/><br/><br/>__________________</td>
                                        <td>Finance<br/><br/><br/>__________________</td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                    </main>
                </body>
            </html>
        </template>
    </data>
</odoo>
