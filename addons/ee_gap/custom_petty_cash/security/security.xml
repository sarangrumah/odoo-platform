<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_petty_cash" model="res.groups.privilege">
            <field name="name">Petty Cash</field>
            <field name="sequence">130</field>
        </record>

        <!-- Employee: raise requests + realizations for themselves. -->
        <record id="group_petty_cash_user" model="res.groups">
            <field name="name">Petty Cash / User</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Finance: review, approve, disburse, post, settle across all. -->
        <record id="group_petty_cash_finance" model="res.groups">
            <field name="name">Petty Cash / Finance</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
