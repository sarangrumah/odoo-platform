<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ===================== FORM ===================== -->
        <record id="view_petty_cash_request_form" model="ir.ui.view">
            <field name="name">petty.cash.request.form</field>
            <field name="model">petty.cash.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="state != 'to_approve'"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_reject" type="object" string="Send Back"
                                invisible="state != 'to_approve'"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_refuse" type="object" string="Refuse"
                                invisible="state not in ('to_approve', 'approved')"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_disburse" type="object" string="Disburse (Bank Out)"
                                class="btn-primary"
                                invisible="state != 'approved' or advance_type_kind in ('pc_realization', 'pc_claim')"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_open_realization" type="object" string="New Realization"
                                class="btn-primary"
                                invisible="state not in ('disbursed', 'in_realization') and not (state == 'approved' and advance_type_kind in ('pc_realization', 'pc_claim'))"/>
                        <button name="action_return_balance" type="object" string="Return Balance"
                                invisible="state not in ('disbursed', 'in_realization') or amount_outstanding &lt;= 0"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_reimburse_shortfall" type="object" string="Reimburse Shortfall"
                                invisible="state not in ('disbursed', 'in_realization') or amount_outstanding &gt;= 0"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_settle" type="object" string="Settle"
                                class="btn-primary"
                                invisible="advance_type_kind in ('pc_realization', 'pc_claim') or state not in ('disbursed', 'in_realization') or amount_outstanding != 0"
                                groups="custom_petty_cash.group_petty_cash_finance"/>
                        <button name="action_close_release" type="object" string="Close &amp; Release"
                                class="btn-primary"
                                invisible="advance_type_kind not in ('pc_realization', 'pc_claim') or state not in ('approved', 'disbursed', 'in_realization')"
                                groups="custom_petty_cash.group_petty_cash_finance"
                                help="Close the request and hand any un-realized remainder back to the store's available balance."/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('settled', 'cancelled')"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                                invisible="state not in ('cancelled', 'to_approve')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,to_approve,approved,disbursed,in_realization,settled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_realizations" type="object" class="oe_stat_button"
                                    icon="fa-list" invisible="realization_count == 0">
                                <field name="realization_count" widget="statinfo" string="Realizations"/>
                            </button>
                            <button name="action_view_moves" type="object" class="oe_stat_button"
                                    icon="fa-book" invisible="move_count == 0">
                                <field name="move_count" widget="statinfo" string="Journal Entries"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                                invisible="not is_overdue"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="advance_type_id" readonly="state != 'draft'"
                                       options="{'no_create': True}"/>
                                <field name="advance_type_kind" invisible="1"/>
                                <field name="pc_ou_allowed_ids" invisible="1"/>
                                <field name="l10n_ou_analytic_id" readonly="state != 'draft'"/>
                                <field name="purpose" readonly="state not in ('draft', 'to_approve')"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="company_currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="request_date" readonly="state != 'draft'"/>
                                <field name="realization_deadline"/>
                                <field name="amount_requested" readonly="state not in ('draft', 'to_approve')"/>
                                <field name="float_id" readonly="1"
                                       invisible="advance_type_kind not in ('pc_initial', 'pc_realization', 'pc_claim')"/>
                                <field name="amount_float_consumed" readonly="1"
                                       invisible="advance_type_kind != 'pc_realization'"/>
                                <field name="x_custom_approval_state" string="Approval Status" readonly="1"
                                       invisible="not x_custom_approval_request_id"/>
                            </group>
                        </group>
                        <group string="Accounting" groups="custom_petty_cash.group_petty_cash_finance">
                            <group>
                                <field name="advance_account_id"/>
                                <field name="bank_journal_id"/>
                            </group>
                            <group>
                                <field name="amount_disbursed"/>
                                <field name="amount_realized"/>
                                <field name="amount_outstanding"/>
                                <field name="amount_outstanding_company"
                                       invisible="currency_id == company_currency_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail Lines" name="detail_lines">
                                <field name="line_ids" readonly="state not in ('draft', 'to_approve')">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="account_id"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ===================== LIST ===================== -->
        <record id="view_petty_cash_request_list" model="ir.ui.view">
            <field name="name">petty.cash.request.list</field>
            <field name="model">petty.cash.request</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'to_approve'"
                      decoration-success="state in ('approved', 'disbursed')"
                      decoration-danger="is_overdue"
                      decoration-muted="state in ('settled', 'cancelled')">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="advance_type_id" optional="show"/>
                    <field name="l10n_ou_analytic_id" optional="show"/>
                    <field name="request_date"/>
                    <field name="realization_deadline" optional="show"/>
                    <field name="amount_requested" sum="Requested"/>
                    <field name="amount_outstanding"/>
                    <field name="amount_outstanding_company" sum="Outstanding" optional="show"/>
                    <field name="company_currency_id" column_invisible="1"/>
                    <field name="is_overdue" optional="hide"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- ===================== KANBAN (monitoring) ===================== -->
        <record id="view_petty_cash_request_kanban" model="ir.ui.view">
            <field name="name">petty.cash.request.kanban</field>
            <field name="model">petty.cash.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="state"/>
                    <field name="is_overdue"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                    <span t-if="record.is_overdue.raw_value" class="float-end badge text-bg-danger">Overdue</span>
                                </div>
                                <div><field name="employee_id"/></div>
                                <div class="text-muted"><field name="advance_type_id"/></div>
                                <div class="text-muted"><field name="l10n_ou_analytic_id"/></div>
                                <div>
                                    Outstanding: <field name="amount_outstanding"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ===================== SEARCH ===================== -->
        <record id="view_petty_cash_request_search" model="ir.ui.view">
            <field name="name">petty.cash.request.search</field>
            <field name="model">petty.cash.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="advance_type_id"/>
                    <field name="l10n_ou_analytic_id"/>
                    <filter name="my_requests" string="My Requests"
                            domain="[('employee_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                    <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="disbursed" string="Disbursed"
                            domain="[('state', 'in', ('disbursed', 'in_realization'))]"/>
                    <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                    <separator/>
                    <filter name="kind_initial" string="Petty Cash Awal"
                            domain="[('advance_type_kind', '=', 'pc_initial')]"/>
                    <filter name="kind_realization" string="Realisasi"
                            domain="[('advance_type_kind', '=', 'pc_realization')]"/>
                    <filter name="kind_claim" string="Claim"
                            domain="[('advance_type_kind', '=', 'pc_claim')]"/>
                    <separator/>
                    <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                    <filter name="reserved" string="Reserving Float"
                            domain="[('amount_float_consumed', '&gt;', 0)]"/>
                    <separator/>
                    <filter name="this_month" string="This Month"
                            domain="[('request_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter name="outstanding" string="Outstanding"
                            domain="[('state', 'in', ('disbursed', 'in_realization')), ('amount_outstanding', '!=', 0)]"/>
                    <group>
                        <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_type" string="Type" context="{'group_by': 'advance_type_id'}"/>
                        <filter name="group_ou" string="Operating Unit" context="{'group_by': 'l10n_ou_analytic_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_kind" string="Type Kind" context="{'group_by': 'advance_type_kind'}"/>
                        <filter name="group_month" string="Request Month" context="{'group_by': 'request_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_petty_cash_request" model="ir.actions.act_window">
            <field name="name">Cash Advance Requests</field>
            <field name="res_model">petty.cash.request</field>
            <field name="view_mode">kanban,list,form,pivot,graph</field>
            <field name="search_view_id" ref="view_petty_cash_request_search"/>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a cash advance request</p>
            </field>
        </record>
    </data>
</odoo>
