<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_petty_cash_type_list" model="ir.ui.view">
            <field name="name">petty.cash.type.list</field>
            <field name="model">petty.cash.type</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="kind"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="advance_account_id"/>
                    <field name="bank_out_journal_id" optional="show"/>
                    <field name="payment_journal_id" optional="hide"/>
                    <field name="expense_journal_id" optional="hide"/>
                    <field name="limit_enforcement"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="limit_outstanding" optional="show"/>
                    <field name="is_default"/>
                </list>
            </field>
        </record>

        <record id="view_petty_cash_type_form" model="ir.ui.view">
            <field name="name">petty.cash.type.form</field>
            <field name="model">petty.cash.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_requests" type="object" class="oe_stat_button"
                                    icon="fa-list" invisible="request_count == 0">
                                <field name="request_count" widget="statinfo" string="Requests"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Cash Advance"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="CA"/>
                                <field name="kind"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="is_default"/>
                                <field name="allow_third_party"/>
                                <field name="realization_days"/>
                                <field name="sequence_id"/>
                            </group>
                        </group>
                        <group string="Accounting">
                            <group>
                                <field name="advance_account_id"/>
                                <field name="bank_out_journal_id"/>
                            </group>
                            <group>
                                <field name="payment_journal_id"/>
                                <field name="expense_journal_id"/>
                            </group>
                        </group>
                        <div class="alert alert-warning" role="alert"
                             invisible="not payment_journal_id">
                            The Payment journal must be <b>dedicated to cash advances</b>. Posting a
                            third-party realization rewrites its payment-method outstanding accounts to
                            point at the Advance account — pointing it at an ordinary bank journal would
                            silently redirect every vendor payment on that bank.
                        </div>
                        <group string="Limits">
                            <group>
                                <field name="limit_enforcement"/>
                                <field name="block_when_overdue"/>
                            </group>
                            <group>
                                <field name="limit_per_request"
                                       invisible="limit_enforcement == 'off'"/>
                                <field name="limit_outstanding"
                                       invisible="limit_enforcement == 'off'"/>
                                <field name="max_open_requests"
                                       invisible="limit_enforcement == 'off'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_petty_cash_type" model="ir.actions.act_window">
            <field name="name">Advance Types</field>
            <field name="res_model">petty.cash.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define an advance type</p>
                <p>
                    A type maps a kind of advance (Cash Advance, Petty Cash, Travel…)
                    to its advance account, journals and limits, per company.
                </p>
            </field>
        </record>
    </data>
</odoo>
