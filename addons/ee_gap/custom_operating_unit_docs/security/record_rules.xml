<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            One shape for every model. Read it as three cases:

              * user not scoped (no unit assigned, or "All Units")  -> [(1,'=',1)]
              * scoped, include_untagged on (the default)           -> own units + untagged
              * scoped, include_untagged off                        -> own units only

            The rules are GLOBAL on purpose: a group-scoped rule would need the
            group membership to be maintained in lockstep with the assignment,
            and getting that wrong silently un-restricts people. Here the
            neutral case is expressed in the domain itself, so installing the
            module restricts nobody until units are actually assigned.

            The untagged branch matters on day one: every historical document
            has a NULL unit until the backfill runs, and without it a store user
            would open Accounting to an empty list and conclude the data is gone.
            Flip custom_operating_unit.include_untagged to "0" per tenant once
            the coverage report is clean.
        -->

        <record id="rule_account_move_ou" model="ir.rule">
            <field name="name">Journal Entry: Operating Unit scope</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">(['|', ('operating_unit_id', '=', False)] if user.ou_include_untagged else []) + [('operating_unit_id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]</field>
        </record>

        <record id="rule_account_move_line_ou" model="ir.rule">
            <field name="name">Journal Item: Operating Unit scope</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="domain_force">(['|', ('operating_unit_id', '=', False)] if user.ou_include_untagged else []) + [('operating_unit_id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]</field>
        </record>

        <record id="rule_account_payment_ou" model="ir.rule">
            <field name="name">Payment: Operating Unit scope</field>
            <field name="model_id" ref="account.model_account_payment"/>
