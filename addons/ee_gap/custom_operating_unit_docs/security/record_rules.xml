        </record>

        <record id="rule_stock_quant_ou" model="ir.rule">
            <field name="name">Quant: Operating Unit scope</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">(['|', ('operating_unit_id', '=', False)] if user.ou_include_untagged else []) + [('operating_unit_id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]</field>
        </record>

        <record id="rule_purchase_order_ou" model="ir.rule">
            <field name="name">Purchase Order: Operating Unit scope</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">(['|', ('operating_unit_id', '=', False)] if user.ou_include_untagged else []) + [('operating_unit_id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]</field>
        </record>

        <record id="rule_sale_order_ou" model="ir.rule">
            <field name="name">Sales Order: Operating Unit scope</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">(['|', ('operating_unit_id', '=', False)] if user.ou_include_untagged else []) + [('operating_unit_id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]</field>
        </record>

        <!-- account.journal and account.account are deliberately NOT scoped:
             restricting them breaks posting, the reconciliation widget and the
             report engine in ways that are very hard to diagnose, and the
             document-level rules above already achieve the isolation. -->
    </data>
</odoo>
