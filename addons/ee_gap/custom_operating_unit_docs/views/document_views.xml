<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- The field is shown to Operating Unit users only: on a tenant that
             does not use the dimension nothing changes visually. The domain is
             UX, not security — the guard is the constraint on the mixin. -->

        <record id="view_move_form_operating_unit" model="ir.ui.view">
            <field name="name">account.move.form.operating.unit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="operating_unit_id"
                           groups="custom_operating_unit.group_operating_unit_user"/>
                </field>
            </field>
        </record>

        <record id="view_picking_form_operating_unit" model="ir.ui.view">
            <field name="name">stock.picking.form.operating.unit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="picking_type_id" position="after">
                    <field name="operating_unit_id"
                           groups="custom_operating_unit.group_operating_unit_user"/>
                </field>
            </field>
        </record>

        <record id="view_purchase_order_form_operating_unit" model="ir.ui.view">
            <field name="name">purchase.order.form.operating.unit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="operating_unit_id"
                           groups="custom_operating_unit.group_operating_unit_user"/>
                </field>
            </field>
        </record>

        <record id="view_sale_order_form_operating_unit" model="ir.ui.view">
            <field name="name">sale.order.form.operating.unit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="operating_unit_id"
                           groups="custom_operating_unit.group_operating_unit_user"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
