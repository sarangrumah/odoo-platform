<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dispatcher: routes to the right per-report template based on
             report_code returned by custom_report_dispatch. -->
        <template id="report_dispatch">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <t t-if="report_code == 'general_ledger'">
                            <t t-call="custom_accounting_reports.report_general_ledger"/>
                        </t>
                        <t t-elif="report_code == 'trial_balance'">
                            <t t-call="custom_accounting_reports.report_trial_balance"/>
                        </t>
                        <t t-elif="report_code == 'balance_sheet'">
                            <t t-call="custom_accounting_reports.report_balance_sheet"/>
                        </t>
                        <t t-elif="report_code == 'profit_loss'">
                            <t t-call="custom_accounting_reports.report_profit_loss"/>
                        </t>
                        <t t-elif="report_code == 'cash_flow'">
                            <t t-call="custom_accounting_reports.report_cash_flow"/>
                        </t>
                        <t t-elif="report_code == 'aged_receivable'">
                            <t t-call="custom_accounting_reports.report_aged_receivable"/>
                        </t>
                        <t t-elif="report_code == 'aged_payable'">
                            <t t-call="custom_accounting_reports.report_aged_payable"/>
                        </t>
                        <t t-elif="report_code == 'partner_ledger'">
                            <t t-call="custom_accounting_reports.report_partner_ledger"/>
                        </t>
                        <t t-elif="report_code == 'payable_card' or report_code == 'receivable_card'">
                            <t t-call="custom_accounting_reports.report_partner_card"/>
                        </t>
                        <t t-elif="report_code == 'advance'">
                            <t t-call="custom_accounting_reports.report_advance"/>
                        </t>
                        <t t-elif="report_code == 'sales'">
                            <t t-call="custom_accounting_reports.report_sales"/>
                        </t>
                        <t t-elif="report_code == 'tax'">
                            <t t-call="custom_accounting_reports.report_tax"/>
                        </t>
                        <t t-elif="report_code == 'faktur_pajak'">
                            <t t-call="custom_accounting_reports.report_faktur_pajak"/>
                        </t>
                        <t t-elif="report_code == 'bupot'">
                            <t t-call="custom_accounting_reports.report_bupot"/>
                        </t>
                        <t t-elif="report_code == 'spt_ppn'">
                            <t t-call="custom_accounting_reports.report_spt_ppn"/>
                        </t>
                        <t t-elif="report_code == 'pph_withholding'">
                            <t t-call="custom_accounting_reports.report_pph_withholding"/>
                        </t>
                        <t t-elif="report_code == 'nsfp_monitoring'">
                            <t t-call="custom_accounting_reports.report_nsfp_monitoring"/>
                        </t>
                        <t t-elif="report_code == 'npwp_quality'">
                            <t t-call="custom_accounting_reports.report_npwp_quality"/>
                        </t>
                        <t t-elif="report_code == 'dpp_nilai_lain'">
                            <t t-call="custom_accounting_reports.report_dpp_nilai_lain"/>
                        </t>
                        <t t-elif="report_code == 'faktur_pengganti'">
                            <t t-call="custom_accounting_reports.report_faktur_pengganti"/>
                        </t>
                        <t t-elif="report_code == 'ekualisasi_omzet'">
                            <t t-call="custom_accounting_reports.report_ekualisasi_omzet"/>
                        </t>
                        <t t-elif="report_code == 'pph_equalisasi'">
                            <t t-call="custom_accounting_reports.report_pph_equalisasi"/>
                        </t>
                        <t t-elif="report_code == 'coretax_submission'">
                            <t t-call="custom_accounting_reports.report_coretax_submission"/>
                        </t>
                        <t t-elif="report_code == 'pajakku_usage'">
                            <t t-call="custom_accounting_reports.report_pajakku_usage"/>
                        </t>
                        <t t-elif="report_code == 'pph_reconciliation'">
                            <t t-call="custom_accounting_reports.report_pph_reconciliation"/>
                        </t>
                        <t t-elif="report_code == 'pph25'">
                            <t t-call="custom_accounting_reports.report_pph25"/>
                        </t>
                        <t t-elif="report_code == 'tax_audit'">
                            <t t-call="custom_accounting_reports.report_tax_audit"/>
                        </t>
                        <t t-elif="report_code == 'day_book'">
                            <t t-call="custom_accounting_reports.report_day_book"/>
                        </t>
                        <t t-elif="report_code == 'cash_book'">
                            <t t-call="custom_accounting_reports.report_cash_book"/>
                        </t>
                        <t t-elif="report_code == 'bank_book'">
                            <t t-call="custom_accounting_reports.report_bank_book"/>
                        </t>
                        <t t-elif="report_code == 'journal_audit'">
                            <t t-call="custom_accounting_reports.report_journal_audit"/>
                        </t>
                        <t t-elif="report_code == 'financial'">
                            <t t-call="custom_accounting_reports.report_financial"/>
                        </t>
                        <t t-else="">
                            <p>Unknown report: <t t-esc="report_code"/></p>
                        </t>
                    </div>
                </t>
            </t>
        </template>

        <template id="report_header">
            <div class="mb-3">
                <h2 class="mb-1" t-esc="report_title"/>
                <div class="text-muted">
                    <span>Company:</span>
                    <strong t-esc="company_names"/>
                    <span class="ms-3">Period:</span>
                    <strong t-esc="date_from_str"/> &#8594;
                    <strong t-esc="date_to_str"/>
                </div>
            </div>
        </template>

        <template id="report_footer_signature">
            <table style="width: 100%; border-collapse: collapse; margin-top: 48px; font-size: 0.8em;">
                <tr>
                    <td style="width: 33.33%; text-align: center; vertical-align: top; padding: 16px 8px 0;">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">Prepared by</div>
                    </td>
                    <td style="width: 33.33%; text-align: center; vertical-align: top; padding: 16px 8px 0;">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">Reviewed by</div>
                    </td>
                    <td style="width: 33.33%; text-align: center; vertical-align: top; padding: 16px 8px 0;">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">Approved by</div>
                    </td>
                </tr>
            </table>
        </template>
    </data>
</odoo>
