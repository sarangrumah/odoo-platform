<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_movement_wizard" model="ir.ui.view">
            <field name="name">custom.report.stock.movement.wizard.form</field>
            <field name="model">custom.report.stock.movement.wizard</field>
            <field name="arch" type="xml">
                <form string="Movement Inventory Detail">
                    <field name="show_stock" invisible="1"/>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_ids" widget="many2many_tags"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="warehouse_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Kosongkan untuk SEMUA warehouse"/>
                            <field name="categ_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="product_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="show_stock">
                        Modul Inventory tidak terpasang di database ini — laporan akan kosong.
                    </div>
                    <footer>
                        <button name="action_view" type="object" string="Tampilkan" class="btn-primary"/>
                        <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-secondary"/>
                        <button name="action_print" type="object" string="Cetak PDF" class="btn-secondary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_stock_movement_wizard" model="ir.actions.act_window">
            <field name="name">Movement Inventory Detail</field>
            <field name="res_model">custom.report.stock.movement.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

