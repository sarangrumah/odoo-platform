<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Shared partials for the branded Invoice / Quotation / Purchase Order
      layout. Each caller sets the context variables below before t-call;
      QWeb t-call shares the caller scope, so partials read them directly:
        o        - the document record
        company  - o.company_id
        accent   - hex accent colour (company.brand_accent_color or fallback)
        currency - o.currency_id (for the monetary widget)
      Partials with a body slot render it via <t t-out="0"/>.
      Styling is inline / Bootstrap-grid only (wkhtmltopdf-safe — no flexbox).
    -->

    <!-- ============ Money (NBSP-free) ============ -->
    <!-- Odoo's monetary widget separates symbol/amount with a non-breaking
         space (U+00A0) which wkhtmltopdf renders as a stray "Â". We format
         locale-correctly here using a normal space instead. Requires in scope:
         amount (float), currency (res.currency), o (record, for its lang).
         NOTE: never use a literal '%' in a QWeb expression — the compiler
         %-formats expression strings (so '%%' collapses to '%'). -->
    <template id="money">
        <t t-set="_lang" t-value="o.env['res.lang']._lang_get(o.env.context.get('lang') or o.env.user.lang or 'en_US')"/>
        <t t-set="_dp" t-value="int(currency.decimal_places)"/>
        <t t-set="_raw" t-value="'{:,.{dp}f}'.format(abs(amount or 0.0), dp=_dp)"/>
        <t t-set="_raw" t-value="_raw.replace(',', '\x00').replace('.', _lang.decimal_point).replace('\x00', _lang.thousands_sep)"/>
        <t t-set="_sign" t-value="'-' if (amount or 0.0) &lt; 0 else ''"/>
        <span style="white-space: nowrap;"><t t-if="currency.position == 'after'"><t t-out="_sign"/><t t-out="_raw"/> <t t-out="currency.symbol"/></t><t t-else=""><t t-out="currency.symbol"/> <t t-out="_sign"/><t t-out="_raw"/></t></span>
    </template>

    <!-- ============ Branded header: logo + address (left), title + meta (right) ============ -->
    <template id="brand_header">
        <div class="row mb-2">
            <div class="col-7">
                <img t-if="company.logo"
                     t-att-src="image_data_uri(company.logo)"
                     style="max-height: 60px; max-width: 240px;" alt="Logo"/>
                <div class="mt-2" style="font-size: 9px; line-height: 1.3;">
                    <div t-if="company.street" t-out="company.street"/>
                    <div t-if="company.street2" t-out="company.street2"/>
                    <div>
                        <span t-if="company.city" t-out="company.city"/><span t-if="company.state_id">, <t t-out="company.state_id.name"/></span><span t-if="company.zip"> <t t-out="company.zip"/></span>
                    </div>
                    <div t-if="company.phone">Phone: <t t-out="company.phone"/></div>
                    <div t-if="company.email">Email: <t t-out="company.email"/></div>
                    <div t-if="company.website">Website: <t t-out="company.website"/></div>
                </div>
            </div>
            <div class="col-5">
                <h2 class="text-end fw-bold mb-3" t-attf-style="color: {{accent}};">
                    <t t-out="doc_title"/>
                </h2>
                <table class="table table-sm table-bordered mb-0" style="width: 100%; font-size: 10px;">
                    <t t-out="0"/>
                </table>
            </div>
        </div>
    </template>

    <!-- ============ FOR / BILL TO band ============ -->
    <template id="party_band">
        <div class="fw-bold px-2 py-1 mb-1" t-attf-style="background-color: {{accent}}; color: #ffffff;">
            <t t-out="band_label"/>
        </div>
        <div class="px-2 mb-3" style="font-size: 10px; line-height: 1.3;">
            <div class="fw-bold" t-out="partner.name"/>
            <div t-if="partner.parent_id and partner.parent_id != partner" t-out="partner.parent_id.name"/>
            <div t-if="partner.street" t-out="partner.street"/>
            <div t-if="partner.street2" t-out="partner.street2"/>
            <div>
                <span t-if="partner.city" t-out="partner.city"/><span t-if="partner.zip"> <t t-out="partner.zip"/></span>
            </div>
            <div t-if="partner.vat">NPWP: <t t-out="partner.vat"/></div>
        </div>
    </template>

    <!-- ============ Items table ============ -->
    <!-- Caller sets: lines (recordset), qty_field (string field name). All
         three line models use the unified `tax_ids` field in Odoo 19. -->
    <template id="items_table">
        <table class="table table-bordered table-sm mb-3" style="font-size: 10px;">
            <thead>
                <tr t-attf-style="background-color: {{accent}}; color: #ffffff;">
                    <th style="width: 38%;">DESCRIPTION</th>
                    <th class="text-end" style="width: 16%;">UNIT PRICE (Rp.)</th>
                    <th class="text-center" style="width: 7%;">QTY</th>
                    <th class="text-center" style="width: 11%;">DISCOUNT</th>
                    <th class="text-center" style="width: 8%;">TAXED</th>
                    <th class="text-end" style="width: 20%;">AMOUNT (Rp.)</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="lines" t-as="line">
                    <t t-if="line.display_type == 'line_section'">
                        <tr>
                            <td colspan="6" class="fw-bold" style="background-color: #f3f3f3;" t-out="line.name"/>
                        </tr>
                    </t>
                    <t t-elif="line.display_type == 'line_note'">
                        <tr>
                            <td colspan="6" class="fst-italic" t-out="line.name"/>
                        </tr>
                    </t>
                    <t t-else="">
                        <tr>
                            <td style="white-space: pre-line;" t-out="line.name"/>
                            <td class="text-end"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="line.price_unit"/></t></td>
                            <td class="text-center" t-out="line[qty_field]"/>
                            <td class="text-center"><t t-out="'{:.1f}'.format(line.discount)"/>%</td>
                            <td class="text-center" t-out="'X' if line.tax_ids else ''"/>
                            <td class="text-end"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="line.price_subtotal"/></t></td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
    </template>

    <!-- ============ OTHER COMMENTS box (body slot) ============ -->
    <template id="comments_box">
        <div class="border" style="font-size: 10px;">
            <div class="fw-bold px-2 py-1" t-attf-style="background-color: {{accent}}; color: #ffffff;">
                OTHER COMMENTS
            </div>
            <div class="px-2 py-2" style="white-space: pre-line;">
                <t t-out="0"/>
            </div>
        </div>
    </template>

    <!-- ============ Totals block ============ -->
    <!-- Caller sets: vat_pct (string, e.g. '11.0'), show_balance (bool). -->
    <template id="totals_block">
        <table class="table table-sm mb-0" style="font-size: 11px;">
            <tr>
                <td class="text-end">Subtotal</td>
                <td class="text-end" style="width: 45%;"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="o.amount_untaxed"/></t></td>
            </tr>
            <tr>
                <td class="text-end">VAT <t t-out="vat_pct"/>%</td>
                <td class="text-end"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="o.amount_tax"/></t></td>
            </tr>
            <tr style="border-top: 2px solid #000;">
                <td class="text-end fw-bold">TOTAL</td>
                <td class="text-end fw-bold"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="o.amount_total"/></t></td>
            </tr>
            <tr t-if="show_balance" t-attf-style="background-color: #e8edf5;">
                <td class="text-end fw-bold">BALANCE DUE</td>
                <td class="text-end fw-bold"><t t-call="custom_report_templates.money"><t t-set="amount" t-value="o.amount_residual"/></t></td>
            </tr>
        </table>
    </template>

    <!-- ============ Signature + footer note ============ -->
    <!-- Caller sets: signer (name or False), doc_noun (e.g. 'order' / 'invoice'). -->
    <template id="signature_block">
        <div class="row mt-4">
            <div class="col-6 offset-6 text-center" style="font-size: 10px;">
                <p class="mb-1">Yours Faithfully,</p>
                <p class="fw-bold mb-0" t-out="company.name"/>
                <div style="height: 80px;"/>
                <p class="mb-0" t-out="signer or ''"/>
            </div>
        </div>
        <div class="text-center mt-4" style="font-size: 10px;">
            <div>If you have any questions about this <t t-out="doc_noun"/>, please contact</div>
            <div class="fw-bold">
                <t t-out="company.name"/><span t-if="company.phone"> at <t t-out="company.phone"/></span>
            </div>
            <div class="fw-bold mt-1" t-out="company.report_footer_note or 'Thank You For Your Business'"/>
        </div>
    </template>

</odoo>
