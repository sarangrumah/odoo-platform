<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fixed_asset_partial_disposal_list" model="ir.ui.view">
        <field name="name">custom.fixed.asset.partial.disposal.list</field>
        <field name="model">custom.fixed.asset.partial.disposal</field>
        <field name="arch" type="xml">
            <list string="Partial Retirements">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="disposal_date"/>
                <field name="reason"/>
                <field name="quantity"/>
                <field name="quantity_before"/>
                <field name="quantity_after"/>
                <field name="cost_removed"/>
                <field name="accumulated_removed"/>
                <field name="net_book_value_removed"/>
                <field name="proceeds"/>
                <field name="gain_loss"/>
                <field name="move_id"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_fixed_asset_partial_disposal_form" model="ir.ui.view">
        <field name="name">custom.fixed.asset.partial.disposal.form</field>
        <field name="model">custom.fixed.asset.partial.disposal</field>
        <field name="arch" type="xml">
            <form string="Partial Retirement">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="1"/>
                            <field name="disposal_date" readonly="1"/>
                            <field name="reason" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="quantity_before" readonly="1"/>
                            <field name="quantity_after" readonly="1"/>
                        </group>
                        <group>
                            <field name="cost_removed"/>
                            <field name="accumulated_removed"/>
                            <field name="net_book_value_removed"/>
                            <field name="proceeds"/>
                            <field name="gain_loss"/>
                            <field name="move_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fixed_asset_partial_disposal" model="ir.actions.act_window">
        <field name="name">Partial Retirements</field>
        <field name="res_model">custom.fixed.asset.partial.disposal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
