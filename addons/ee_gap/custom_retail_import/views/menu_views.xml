<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_retail_import_root" name="Retail Import"
              groups="group_retail_import_user" sequence="95"/>

    <!-- Imports list is the FIRST child so clicking the "Retail Import" app lands
         on the list page, not the Upload File dialog (target=new). -->
    <menuitem id="menu_retail_import_logs" name="Imports"
              parent="menu_retail_import_root"
              action="action_retail_import_log" sequence="1"/>

    <menuitem id="menu_retail_import_run" name="Upload File"
              parent="menu_retail_import_root"
              action="action_retail_import_wizard" sequence="10"/>

    <menuitem id="menu_retail_import_sync" name="Sync from FTP"
              parent="menu_retail_import_root"
              action="action_server_sync_feeds" sequence="20"/>

    <menuitem id="menu_retail_import_lines" name="Row Results"
              parent="menu_retail_import_root"
              action="action_retail_import_log_line" sequence="30"/>

    <menuitem id="menu_retail_import_config" name="Configuration"
              parent="menu_retail_import_root" sequence="90"
              groups="group_retail_import_manager"/>

    <menuitem id="menu_retail_import_profiles" name="Import Profiles"
              parent="menu_retail_import_config"
              action="action_retail_import_profile" sequence="10"/>

    <menuitem id="menu_retail_import_feeds" name="Feeds"
              parent="menu_retail_import_config"
              action="action_retail_import_feed" sequence="20"/>

    <menuitem id="menu_retail_import_settings" name="Settings"
              parent="menu_retail_import_config"
              action="action_retail_import_config_settings" sequence="30"/>
</odoo>
