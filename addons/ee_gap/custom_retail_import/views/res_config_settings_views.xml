<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_import_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.retail.import</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Retail Import" string="Retail Import" name="custom_retail_import">
                    <block title="Processing" name="retail_import_processing">
                        <setting string="Queue Job Channel" help="queue_job channel for asynchronous imports.">
                            <field name="retail_import_queue_channel"/>
                        </setting>
                        <setting string="Max Log Lines per Import"
                                 help="Cap on stored per-row log lines for one import. Counters stay exact even when truncated.">
                            <field name="retail_import_max_log_lines"/>
                        </setting>
                        <setting string="Alert on Import Failure"
                                 help="Fire a best-effort alert when an import fails.">
                            <field name="retail_import_alert_on_failure"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_retail_import_config_settings" model="ir.actions.act_window">
        <field name="name">Retail Import Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'custom_retail_import'}</field>
    </record>
</odoo>
