<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_import_log_line_list" model="ir.ui.view">
        <field name="name">retail.import.log.line.list</field>
        <field name="model">retail.import.log.line</field>
        <field name="arch" type="xml">
            <list string="Row Results" create="false"
                  decoration-danger="status=='error'" decoration-warning="status=='duplicate'"
                  decoration-info="status=='archived'" decoration-muted="status=='skipped'"
                  decoration-success="status=='created'">
                <field name="log_id"/>
                <field name="row"/>
                <field name="status" widget="badge"/>
                <field name="ref_key"/>
                <field name="model_name" optional="hide"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_retail_import_log_line_form" model="ir.ui.view">
        <field name="name">retail.import.log.line.form</field>
        <field name="model">retail.import.log.line</field>
        <field name="arch" type="xml">
            <form string="Row Result" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="log_id"/>
                            <field name="row"/>
                            <field name="status"/>
                            <field name="ref_key"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Raw values" invisible="not raw_json">
                        <field name="raw_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_retail_import_log_line_search" model="ir.ui.view">
        <field name="name">retail.import.log.line.search</field>
        <field name="model">retail.import.log.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref_key"/>
                <field name="message"/>
                <field name="log_id"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <filter name="duplicates" string="Duplicates" domain="[('status','=','duplicate')]"/>
                <filter name="archived" string="Archived" domain="[('status','=','archived')]"/>
                <filter name="created" string="Created" domain="[('status','=','created')]"/>
                <filter name="updated" string="Updated" domain="[('status','=','updated')]"/>
                <filter name="skipped" string="Skipped" domain="[('status','=','skipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                    <filter name="group_log" string="Import" context="{'group_by':'log_id'}"/>
                    <filter name="group_key" string="Key" context="{'group_by':'ref_key'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_retail_import_log_line" model="ir.actions.act_window">
        <field name="name">Row Results</field>
        <field name="res_model">retail.import.log.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
