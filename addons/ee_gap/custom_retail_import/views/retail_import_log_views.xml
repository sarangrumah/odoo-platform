<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_import_log_list" model="ir.ui.view">
        <field name="name">retail.import.log.list</field>
        <field name="model">retail.import.log</field>
        <field name="arch" type="xml">
            <list string="Imports" decoration-success="state=='imported'" decoration-warning="state=='partial'" decoration-danger="state=='failed'" decoration-muted="state in ('queued','running')">
                <header>
                    <button name="action_open_wizard" type="object" string="Upload File" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="file_type"/>
                <field name="filename"/>
                <field name="line_count"/>
                <field name="records_created"/>
                <field name="records_updated"/>
                <field name="records_skipped"/>
                <field name="duplicate_count"/>
                <field name="error_count"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="imported_by_id"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>

    <record id="view_retail_import_log_form" model="ir.ui.view">
        <field name="name">retail.import.log.form</field>
        <field name="model">retail.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Log">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" icon="fa-refresh"/>
                    <button name="action_reprocess" type="object" string="Re-process"
                            invisible="state == 'running'"
                            confirm="Re-run the import from the stored source file? Prior row results are cleared."/>
                    <button name="action_download_source" type="object" string="Download Source"
                            invisible="not attachment_id"/>
                    <button name="action_download_errors" type="object" string="Download Error Report"
                            invisible="error_count == 0 and duplicate_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_created" type="object" class="oe_stat_button"
                                icon="fa-plus-circle" invisible="records_created == 0">
                            <field name="records_created" widget="statinfo" string="Created"/>
                        </button>
                        <button name="action_view_updated" type="object" class="oe_stat_button"
                                icon="fa-pencil" invisible="records_updated == 0">
                            <field name="records_updated" widget="statinfo" string="Updated"/>
                        </button>
                        <button name="action_view_duplicates" type="object" class="oe_stat_button"
                                icon="fa-clone" invisible="duplicate_count == 0">
                            <field name="duplicate_count" widget="statinfo" string="Duplicates"/>
                        </button>
                        <button name="action_view_errors" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="error_count == 0">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group invisible="state not in ('queued','running')">
                        <field name="progress" widget="progressbar"/>
                    </group>
                    <group>
                        <group string="Source">
                            <field name="profile_id"/>
                            <field name="file_type"/>
                            <field name="filename"/>
                            <field name="attachment_id"/>
                            <field name="file_hash"/>
                            <field name="job_uuid"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Result">
                            <field name="line_count"/>
                            <field name="records_created"/>
                            <field name="records_updated"/>
                            <field name="records_archived"/>
                            <field name="records_skipped"/>
                            <field name="duplicate_count"/>
                            <field name="error_count"/>
                            <field name="lines_truncated"/>
                        </group>
                        <group string="Audit">
                            <field name="imported_by_id"/>
                            <field name="imported_at"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration" widget="float_time"/>
                            <field name="processed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Row Results" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="status=='error'" decoration-warning="status=='duplicate'"
                                      decoration-info="status=='archived'" decoration-muted="status=='skipped'"
                                      decoration-success="status=='created'">
                                    <field name="row"/>
                                    <field name="status" widget="badge"/>
                                    <field name="ref_key"/>
                                    <field name="model_name" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Error message" name="error" invisible="not error_message">
                            <field name="error_message" nolabel="1"/>
                        </page>
                        <page string="Legacy row errors" name="legacy" invisible="not raw_payload or line_ids">
                            <field name="raw_payload" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_retail_import_log_search" model="ir.ui.view">
        <field name="name">retail.import.log.search</field>
        <field name="model">retail.import.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="filename"/>
                <field name="profile_id"/>
                <field name="imported_by_id"/>
                <filter name="imported" string="Imported" domain="[('state','=','imported')]"/>
                <filter name="partial" string="Partial" domain="[('state','=','partial')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="with_errors" string="With errors" domain="[('error_count','>',0)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('imported_at','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_file_type" string="File Type" context="{'group_by':'file_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_user" string="Uploaded By" context="{'group_by':'imported_by_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by':'imported_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_retail_import_log_pivot" model="ir.ui.view">
        <field name="name">retail.import.log.pivot</field>
        <field name="model">retail.import.log</field>
        <field name="arch" type="xml">
            <pivot string="Imports">
                <field name="file_type" type="row"/>
                <field name="imported_at" interval="month" type="col"/>
                <field name="records_created" type="measure"/>
                <field name="records_updated" type="measure"/>
                <field name="error_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_retail_import_log_graph" model="ir.ui.view">
        <field name="name">retail.import.log.graph</field>
        <field name="model">retail.import.log</field>
        <field name="arch" type="xml">
            <graph string="Imports" type="bar">
                <field name="imported_at" interval="month"/>
                <field name="records_created" type="measure"/>
                <field name="error_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_retail_import_log" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="res_model">retail.import.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No imports yet</p>
            <p>Click <b>Upload File</b> to import a retail data file (Excel/CSV), or configure an SFTP/FTP feed under Configuration.</p>
        </field>
    </record>
</odoo>
