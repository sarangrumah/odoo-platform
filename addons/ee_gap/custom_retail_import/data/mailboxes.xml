<?xml version="1.0" encoding="utf-8"?>
<!-- IMAP mailbox that receives the nightly Levi's X-center reports.

     Ships INACTIVE with purge disabled and dry_run on. Four switches must be thrown
     by hand, in this order, and only in the ONE database that owns this mailbox:

       1. active         -> start fetching (backup + drop dir). Nothing is deleted,
                            and nothing is imported until step 4.
       2. purge_enabled  -> arm retention; with dry_run still on it only reports.
       3. dry_run = off  -> messages older than retention_days are really expunged.
       4. ir.cron `cron_poll_retail_feeds` -> active. THIS is the one that imports and,
                            where retail_import.x24_post_enabled is set, posts journal
                            entries. Do it only after the X70D-vs-pos.payment Rp 0
                            reconciliation.

     Two databases polling the same INBOX would race to delete each other's messages;
     the advisory lock in _lock() only guards workers within one database.

     No password here. The Odoo container reads LEVIS_MAIL_PASSWORD from its environment
     (see docker-compose.yml); password_param is a fallback that stores the secret in
     clear text in the database.

     noupdate="1": operational record — admin edits survive module upgrades. -->
<odoo noupdate="1">

    <record id="mailbox_levis_xcenter" model="retail.import.mailbox">
        <field name="name">Levi's X-center — nightly reports</field>
        <field name="host">mail.erajaya.com</field>
        <field name="port">993</field>
        <field name="use_ssl" eval="True"/>
        <field name="username">levis.data@erajaya.com</field>
        <field name="password_env">LEVIS_MAIL_PASSWORD</field>
        <field name="folder">INBOX</field>
        <field name="sender_filter">XcenterAdmin@levi.com</field>

        <!-- Back up all six nightly reports... -->
        <field name="attachment_glob">*.xlsx</field>
        <!-- ...but only hand X24 / X70D / X31 to the import feeds. X20 is a one-shot
             opening-balance loader whose profile expects a different CSV layout, and
             X32P / X70T are staged-only today. -->
        <field name="ingest_glob">X24*.xlsx,X70D*.xlsx,X31*.xlsx</field>

        <field name="drop_dir">/mnt/data_levis/data</field>
        <field name="backup_dir">/mnt/data_levis/mailbox</field>

        <field name="retention_days">30</field>
        <field name="max_messages">400</field>
        <field name="max_bytes_mb">600</field>

        <field name="active" eval="False"/>
        <field name="purge_enabled" eval="False"/>
        <field name="dry_run" eval="True"/>
    </record>

    <!-- Second mailbox on the SAME INBOX, for the X70D that stores export themselves.

         Why a second record rather than widening the first: the two sources need
         opposite handling. The nightly file is the system of record and is posted;
         the store file is a lookup and must never be posted. They also need different
         drop directories — the store file is named "X70D_Tender_Detail_Report -OLS
         MKG SEPTEMBER 2026.xlsx", which matches feed_levis_x70d's own X70D*.xlsx
         glob. Dropped beside the nightly file it would be imported as a second
         nightly file and would duplicate a store's sales.

         The two records never fight over a message because their sender filters are
         disjoint: the nightly reports come from XcenterAdmin@levi.com, the store
         reports from a person at @erajaya.com. IMAP SEARCH cannot express "not from
         X", so the separation has to come from the addresses themselves — do not
         blank this filter.

         Purge stays OFF here whatever the other mailbox does. Store mail is sent
         weekly and cumulative, so an old message is still the only copy of the weeks
         it covers, and retention measured from the send date would delete it while
         it is current. -->
    <record id="mailbox_levis_store_tender" model="retail.import.mailbox">
        <field name="name">Levi's stores — weekly X70D export</field>
        <field name="host">mail.erajaya.com</field>
        <field name="port">993</field>
        <field name="use_ssl" eval="True"/>
        <field name="username">levis.data@erajaya.com</field>
        <field name="password_env">LEVIS_MAIL_PASSWORD</field>
        <field name="folder">INBOX</field>
        <field name="sender_filter">erajaya.com</field>

        <!-- Back up every attachment: the stores also send "LAPORAN HARIAN", a manual
             retype of the same data whose only original column is a free-text remark
             (split payment, short swipe). It is kept because that remark explains
             differences, and deliberately not ingested: its retyped figures disagree
             with the export they were copied from. -->
        <field name="attachment_glob">*.xlsx</field>
        <field name="ingest_glob">*.xlsx</field>
        <field name="ingest_signature">TRANSNUM,TENDER AMOUNT</field>
        <field name="ingest_store_check" eval="True"/>

        <field name="drop_dir">/mnt/data_levis/data_store</field>
        <field name="backup_dir">/mnt/data_levis/mailbox_store</field>

        <field name="retention_days">0</field>
        <field name="max_messages">0</field>
        <field name="max_bytes_mb">0</field>

        <field name="active" eval="False"/>
        <field name="purge_enabled" eval="False"/>
        <field name="dry_run" eval="True"/>
    </record>

</odoo>
