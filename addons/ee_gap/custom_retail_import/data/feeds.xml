<?xml version="1.0" encoding="utf-8"?>
<!-- Local FTPS-drop feeds for the Levi's (SES) tenant.

     Partners push source files over the bundled FTPS server into the shared
     ./data/data_levis/data folder (mounted at /mnt/data_levis inside Odoo).
     Each feed binds a filename glob to a retail.import.profile; on a successful
     import the file is moved to /mnt/data_levis/archive with a YYYYMMDD_HHMMSS_
     prefix (see retail.import.feed._poll_one_local).

     noupdate="1": these are operational records — admin edits (enabling a feed,
     tweaking a glob, repointing a directory) survive module upgrades.

     Globs follow the real Levi's report filenames (docs/levis/), e.g.
     X20_Current_Onhand_Inventory_Report-*.csv, X24DN_Retail_Sales_Detail_*.xlsx,
     X70D_Tender_Detail_Report.xlsx.

     Activation policy:
       * Daily transaction drops (X20/X24/X70D) -> active, ready for "Poll Now"
         and (once enabled) the cron_poll_retail_feeds scheduler.
       * Master data + staged/reference-gated types -> inactive; review the glob
         and load path before enabling. -->
<odoo noupdate="1">

    <!-- ===== Daily transaction drops (active) ===== -->
    <record id="feed_levis_x20" model="retail.import.feed">
        <field name="name">Levi's X20 — On-hand Inventory (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x20"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X20*.csv</field>
        <field name="active" eval="True"/>
    </record>

    <record id="feed_levis_x24" model="retail.import.feed">
        <field name="name">Levi's X24 — Retail Sales Detail (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x24"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X24*.xlsx</field>
        <field name="active" eval="True"/>
    </record>

    <record id="feed_levis_x70d" model="retail.import.feed">
        <field name="name">Levi's X70D — Tender Detail (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x70d"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X70D*.xlsx</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ===== Master data + staged types (inactive: review before enabling) ===== -->
    <record id="feed_levis_x101" model="retail.import.feed">
        <field name="name">Levi's X101 — Material Master (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x101"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X101*.xlsx</field>
        <field name="active" eval="False"/>
    </record>

    <record id="feed_levis_coa" model="retail.import.feed">
        <field name="name">Levi's CoA — Chart of Accounts (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_coa"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">CoA*.xlsx</field>
        <field name="active" eval="False"/>
    </record>

    <record id="feed_levis_x31" model="retail.import.feed">
        <field name="name">Levi's X31 — Discount Journal (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x31"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X31*.xlsx</field>
        <field name="active" eval="False"/>
    </record>

    <record id="feed_levis_x32p" model="retail.import.feed">
        <field name="name">Levi's X32P — Stock Movement w/ Price (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x32p"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X32P*.xlsx</field>
        <field name="active" eval="False"/>
    </record>

    <record id="feed_levis_x70" model="retail.import.feed">
        <field name="name">Levi's X70T — Tender Settlement (FTPS drop)</field>
        <field name="profile_id" ref="profile_levis_x70"/>
        <field name="source_type">local</field>
        <field name="local_dir">/mnt/data_levis/data</field>
        <field name="archive_dir">/mnt/data_levis/archive</field>
        <field name="file_glob">X70T*.xlsx</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
