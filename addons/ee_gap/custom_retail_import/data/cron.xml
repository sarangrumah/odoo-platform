<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Feed poller (SFTP pull + local FTPS-drop feeds). Disabled by default:
         enable once a retail.import.feed is configured for the tenant (Phase 6).
         Daily cadence suits the steady state (prior-day X24 sales + X20 on-hand
         refresh); shorten to hourly for near-real-time FTPS drops. -->
    <record id="cron_poll_retail_feeds" model="ir.cron">
        <field name="name">Retail Import: poll feeds</field>
        <field name="model_id" ref="model_retail_import_feed"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_feeds()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
