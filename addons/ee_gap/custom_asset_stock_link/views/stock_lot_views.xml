<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_asset" model="ir.ui.view">
        <field name="name">stock.lot.form.asset</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fixed_asset" type="object"
                        class="oe_stat_button" icon="fa-building"
                        string="Fixed Asset"
                        invisible="not fixed_asset_ids"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="fixed_asset_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
