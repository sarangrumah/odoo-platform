<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coretax_fk_export_form" model="ir.ui.view">
        <field name="name">custom.coretax.fk.export.wizard.form</field>
        <field name="model">custom.coretax.fk.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export e-Faktur Keluaran (FK/OF)">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"
                               placeholder="Semua pelanggan"/>
                        <field name="journal_ids" widget="many2many_tags"
                               placeholder="Semua jurnal penjualan"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="preview_count > 0 or not empty_reason">
                    <field name="empty_reason" nolabel="1" readonly="1"/>
                </div>
                <div class="text-muted">
                    <field name="preview_count" class="oe_inline"/> faktur penjualan
                    ter-posting akan masuk ke berkas. Hanya faktur penjualan yang
                    diekspor — nota kredit ditangani lewat Faktur Pengganti / Retur.
                </div>
                <footer>
                    <button name="action_export" type="object" string="Export"
                            class="btn-primary"/>
                    <button special="cancel" string="Tutup" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_coretax_fk_export" model="ir.actions.act_window">
        <field name="name">Export e-Faktur Keluaran (FK)</field>
        <field name="res_model">custom.coretax.fk.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
