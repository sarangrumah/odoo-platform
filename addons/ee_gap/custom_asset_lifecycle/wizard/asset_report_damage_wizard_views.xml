<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_report_damage_wizard_form" model="ir.ui.view">
        <field name="name">custom.asset.report.damage.wizard.form</field>
        <field name="model">custom.asset.report.damage.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Damage">
                <div class="alert alert-info" role="alert">
                    The unit stays a running asset and keeps depreciating. Only a
                    write-off stops depreciation.
                </div>
                <group>
                    <group>
                        <field name="event_date"/>
                        <field name="reference" placeholder="Incident report / BAP no."/>
                        <field name="asset_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="move_serial"/>
                        <field name="damage_location_id"
                               invisible="not move_serial"/>
                        <field name="without_serial_count" readonly="1"
                               invisible="without_serial_count == 0"
                               string="Units Without A Serial (skipped)"/>
                    </group>
                </group>
                <group string="Assets">
                    <field name="asset_ids" nolabel="1">
                        <list create="false">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="condition"/>
                            <field name="stock_location_id"/>
                        </list>
                    </field>
                </group>
                <group string="Repair">
                    <group>
                        <field name="create_repair"/>
                        <field name="repair_channel" widget="radio"
                               invisible="not create_repair"
                               required="create_repair"/>
                    </group>
                    <group>
                        <field name="repair_vendor_id"
                               invisible="not create_repair or repair_channel != 'third_party'"
                               required="create_repair and repair_channel == 'third_party'"/>
                        <field name="warranty_claim_ref"
                               invisible="not create_repair or repair_channel != 'warranty'"
                               required="create_repair and repair_channel == 'warranty'"/>
                        <field name="promised_date" invisible="not create_repair"/>
                    </group>
                </group>
                <group string="What Happened">
                    <field name="description" nolabel="1"
                           placeholder="Describe the damage: what failed, how, and where..."/>
                </group>
                <footer>
                    <button name="action_report_damage" type="object"
                            string="Report Damage" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
