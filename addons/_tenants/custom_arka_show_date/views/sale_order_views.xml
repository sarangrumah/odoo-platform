<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_arka_show_date" model="ir.ui.view">
        <field name="name">sale.order.form.arka.show.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="validity_date" position="after">
                <field name="x_custom_show_date_required" invisible="1"/>
                <field name="x_custom_show_date"
                       invisible="not x_custom_show_date_required"
                       required="x_custom_show_date_required"/>
                <field name="x_custom_event_name"
                       invisible="not x_custom_show_date_required"/>
                <field name="x_custom_event_location"
                       invisible="not x_custom_show_date_required"/>
                <field name="x_custom_dp_note"
                       invisible="not x_custom_show_date_required"
                       placeholder="DP 50%"/>
            </field>
            <xpath expr="//header" position="inside">
                <field name="x_custom_ic_purchase_available" invisible="1"/>
                <button name="action_custom_create_ic_purchase_order"
                        type="object"
                        string="Buat PO ke Sister Company"
                        invisible="not x_custom_ic_purchase_available or state in ('cancel',)"
                        help="Raise a draft purchase order on the sister company, carrying this order's event, show date and lines."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_custom_view_event_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="x_custom_event_po_count == 0">
                    <field name="x_custom_event_po_count" widget="statinfo" string="Purchase"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
