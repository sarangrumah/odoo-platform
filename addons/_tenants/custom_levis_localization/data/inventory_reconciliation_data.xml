<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_levis_inventory_reconciliation" model="ir.sequence">
        <field name="name">Inventory Reconciliation</field>
        <field name="code">levis.inventory.reconciliation</field>
        <field name="prefix">INVREC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Optional monthly draft generator. Disabled by default; enable and set
         the company/journal defaults per tenant if you want it automated. -->
    <record id="cron_levis_inventory_reconciliation" model="ir.cron">
        <field name="name">Levi's: Periodic Inventory Reconciliation (draft)</field>
        <field name="model_id" ref="model_levis_inventory_reconciliation"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
