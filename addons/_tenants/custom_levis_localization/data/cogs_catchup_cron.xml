<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The nightly half of the catch-up: sweep whatever the receipt hook could
      not see (a cost that appeared without a receipt behind it), then post the
      draft entries whose booking date has passed. Today's entry is left alone
      so the day keeps collecting into ONE journal entry.

      Shipped inactive. Before switching it on, make sure the charge ledger
      covers every period that was booked by hand — a manual journal leaves no
      levis.cogs.charge row, so the catch-up cannot see it and would charge the
      same units again (August 2026: Rp 528 m). Seed it first with
      scripts/tenants/levis/126_seed_cogs_charge_manual.py.

      nextcall is UTC: 19:00 = 02:00 the next day in Asia/Jakarta.
    -->
    <record id="cron_levis_cogs_catchup" model="ir.cron">
        <field name="name">Levi's: COGS Catch-up Sweep and Post</field>
        <field name="model_id" ref="model_levis_cogs_catchup"/>
        <field name="state">code</field>
        <field name="code">model._cron_catch_up()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-10-01 19:00:00</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
