<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trade / Non-Trade purchase type on the PO (feature #9) -->
    <record id="view_purchase_order_form_levis_type" model="ir.ui.view">
        <field name="name">purchase.order.form.levis.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_purchase_type" widget="radio" options="{'horizontal': True}"/>
                <field name="l10n_ou_analytic_display" readonly="1"/>
                <field name="l10n_dup_sku_ack" invisible="1"/>
                <field name="l10n_dup_sku_reason" readonly="1" invisible="not l10n_dup_sku_ack"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_tree_levis_type" model="ir.ui.view">
        <field name="name">purchase.order.list.levis.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_purchase_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_search_levis_type" model="ir.ui.view">
        <field name="name">purchase.order.search.levis.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_purchases" position="before">
                <filter string="Trade" name="levis_trade"
                        domain="[('l10n_purchase_type', '=', 'trade')]"/>
                <filter string="Non-Trade" name="levis_non_trade"
                        domain="[('l10n_purchase_type', '=', 'non_trade')]"/>
                <separator/>
            </filter>
            <group position="inside">
                <filter string="Purchase Type" name="group_levis_type"
                        context="{'group_by': 'l10n_purchase_type'}"/>
            </group>
        </field>
    </record>
</odoo>
