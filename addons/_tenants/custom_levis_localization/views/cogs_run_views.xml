<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_levis_cogs_run_form" model="ir.ui.view">
        <field name="name">levis.cogs.run.form</field>
        <field name="model">levis.cogs.run</field>
        <field name="arch" type="xml">
            <form string="Periodic COGS">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary"
                            invisible="state == 'generated'"/>
                    <button name="action_generate_move" type="object"
                            string="Generate Journal Entry"
                            invisible="state == 'generated'"/>
                    <button name="action_post_period" type="object"
                            string="Post Period" class="btn-primary"
                            confirm="Post every draft COGS entry of this period and book the units nothing has recognised yet?"/>
                    <button name="action_view_move" type="object"
                            string="View Journal Entry"
                            invisible="not move_id"/>
                    <button name="action_backfill_charges" type="object"
                            string="Backfill Charge Ledger"
                            confirm="Reconstruct the charge ledger for this run? Only do this for a run generated before the ledger existed."
                            invisible="state != 'generated' or charge_count &gt; 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="move_id" readonly="1"/>
                            <field name="charge_count" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="zero_cost_qty == 0">
                        <field name="zero_cost_qty" readonly="1" nolabel="1"
                               class="oe_inline"/>
                        units were sold with no cost on the product, so the COGS
                        below is understated. Load the purchases for those
                        products and press Compute again.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="total_draft == 0">
                        <field name="total_draft" readonly="1" nolabel="1"
                               class="oe_inline"/>
                        of this period's cost sits in
                        <field name="period_draft_move_count" readonly="1" nolabel="1"
                               class="oe_inline"/>
                        journal entr(ies) that are still draft — a receipt
                        catch-up, or one the accountant wrote. They are listed
                        under <b>Journal Entries of This Period</b> and are
                        deliberately NOT booked again below. Post Period posts
                        the ones this module wrote and books only what is left.
                    </div>
                    <notebook>
                      <page string="Per Store and Category" name="lines">
                    <field name="line_ids">
                        <list create="false" editable="bottom">
                            <field name="warehouse_id"/>
                            <field name="analytic_account_id"/>
                            <field name="product_categ_id"/>
                            <field name="expense_account_id"/>
                            <field name="valuation_account_id"/>
                            <field name="sold_qty" sum="Sold"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="posted_qty" sum="Qty in GL" optional="hide"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="posted_amount" sum="Already in the GL"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="draft_qty" sum="Qty in draft" optional="hide"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="draft_amount" sum="Waiting in a draft entry"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="void_qty" sum="Entry gone" optional="hide"
                                   column_invisible="parent.state == 'generated'"/>
                            <field name="quantity" sum="Qty"/>
                            <field name="zero_cost_qty" sum="Qty w/o cost"/>
                            <field name="amount" sum="COGS"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                      </page>
                      <page string="Journal Entries of This Period" name="period_moves">
                        <div class="text-muted mb-2">
                            Every entry that recognised cost for this period —
                            this run's own, the receipt catch-ups, the POS
                            sessions, and anything an accountant wrote by hand.
                            A draft row is cost that is NOT in the general ledger
                            yet; Post Period posts the ones this module wrote and
                            names the rest.
                        </div>
                        <field name="period_move_ids" readonly="1">
                            <list create="false" delete="false" open_form_view="1">
                                <field name="date"/>
                                <field name="name"/>
                                <field name="journal_id" optional="hide"/>
                                <field name="ref" optional="show"/>
                                <field name="levis_cogs_source"/>
                                <field name="levis_cogs_qty" sum="Units"/>
                                <field name="levis_cogs_amount" sum="COGS Recognised"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'posted'"
                                       decoration-warning="state == 'draft'"
                                       decoration-danger="state == 'cancel'"/>
                                <field name="company_currency_id" column_invisible="1"/>
                            </list>
                        </field>
                      </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_posted" widget="monetary"/>
                        <field name="total_draft" widget="monetary"/>
                        <field name="total_cogs" widget="monetary"
                               string="To Book"
                               invisible="state == 'generated'"/>
                        <field name="total_cogs" widget="monetary"
                               string="Booked by This Run"
                               invisible="state != 'generated'"/>
                        <field name="total_period" widget="monetary"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_levis_cogs_run_list" model="ir.ui.view">
        <field name="name">levis.cogs.run.list</field>
        <field name="model">levis.cogs.run</field>
        <field name="arch" type="xml">
            <list string="Periodic COGS">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_posted" sum="In the GL" optional="show"/>
                <field name="total_draft" sum="In a draft entry" optional="show"/>
                <field name="total_cogs" sum="This run's entry"/>
                <field name="total_period" sum="COGS of the period" optional="show"/>
                <field name="state"
                       decoration-success="state == 'generated'"
                       decoration-info="state == 'computed'"
                       widget="badge"/>
                <field name="move_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_levis_cogs_run" model="ir.actions.act_window">
        <field name="name">Periodic COGS</field>
        <field name="res_model">levis.cogs.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Recognise COGS for a period</p>
            <p>Multiplies the quantity sold at each store by the product cost that
               the goods receipts established, and books a draft
               Dr COGS / Cr Inventory entry carrying the store's Operating Unit,
               so the P&amp;L splits per store.</p>
        </field>
    </record>

    <menuitem id="menu_levis_cogs_run"
              name="Periodic COGS"
              parent="account.menu_finance_entries"
              action="action_levis_cogs_run"
              sequence="91"/>
</odoo>
