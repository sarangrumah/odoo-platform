<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_levis_warehouse_form" model="ir.ui.view">
        <field name="name">stock.warehouse.form.levis.store.code</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="l10n_store_code"
                       placeholder="e.g. SNC"
                       help="The code this store is known by outside Odoo — on the
                             retail feed, on a cash-deposit transfer memo, and on the
                             bank statement. Leave empty rather than inventing one."/>
            </field>
        </field>
    </record>

    <record id="view_levis_warehouse_list" model="ir.ui.view">
        <field name="name">stock.warehouse.list.levis.store.code</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <!-- The core list carries no ``code`` field, so anchor on ``name``. -->
            <field name="name" position="after">
                <field name="l10n_store_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
