<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_admin_fee" model="ir.ui.view">
        <field name="name">account.payment.register.form.admin.fee</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <!--
                  Feature #20: show WHAT is being paid. The wizard already holds
                  the AP lines it pulled in, but never listed them, so an
                  operator settling a batch had to leave the dialog to check the
                  bills. Read-only: the selection is made by picking the bills
                  before opening the wizard.
                -->
                <group string="Bills Being Paid" invisible="not l10n_bill_ids">
                    <field name="l10n_bill_ids" nolabel="1" colspan="2" readonly="1">
                        <list create="false" delete="false">
                            <field name="name" string="Bill No"/>
                            <field name="invoice_date" string="Bill Date"/>
                            <field name="invoice_date_due" string="Due Date"/>
                            <field name="ref" string="Vendor Ref"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_total" string="Total"/>
                            <field name="amount_residual" string="Amount Due"/>
                        </list>
                    </field>
                </group>
                <group string="Card MDR"
                       invisible="not can_edit_wizard or payment_type != 'inbound' or (can_group_payments and not group_payment)">
                    <field name="x_card_bin" placeholder="e.g. 400000"/>
                    <field name="x_mdr_bin_id" invisible="not x_mdr_bin_id"/>
                </group>
                <group string="Additional Info">
                    <field name="l10n_ou_analytic_id" options="{'no_create': True}"/>
                    <field name="l10n_override_outstanding_account_id"
                           options="{'no_create': True}"/>
                    <field name="l10n_note"/>
                    <field name="l10n_remark"/>
                </group>
                <group string="Admin Fees" invisible="not can_edit_wizard">
                    <div colspan="2" class="alert alert-info mb-2" role="status"
                         invisible="not can_group_payments or not group_payment or not admin_fee_line_ids">
                        The selected bills are paid with a <b>single</b> payment, so the
                        admin fee below is charged once for the whole transfer.
                    </div>
                    <div colspan="2" class="alert alert-warning mb-2" role="alert"
                         invisible="not can_group_payments or group_payment">
                        Tick <b>Group Payments</b> above to add admin fees. Without it Odoo
                        creates one payment per bill, and a single fee cannot be split
                        across them. Adding a fee line below ticks it for you.
                    </div>
                    <field name="admin_fee_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="is_mdr" column_invisible="1"/>
                            <field name="name" readonly="is_mdr"/>
                            <field name="account_id"
                                   readonly="is_mdr"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount" readonly="is_mdr"/>
                        </list>
                    </field>
                    <field name="admin_fee_total"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           invisible="not admin_fee_line_ids"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
