<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_levis_store_cash_deposit_form" model="ir.ui.view">
        <field name="name">levis.store.cash.deposit.form</field>
        <field name="model">levis.store.cash.deposit</field>
        <field name="arch" type="xml">
            <form string="Store Cash Deposit">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_pull_sessions" type="object" string="Pull Sessions"
                            invisible="state in ('matched', 'cancel')"/>
                    <button name="action_open_statement_line" type="object" string="Bank Credit"
                            invisible="not statement_line_id"/>
                    <button name="action_unmatch" type="object" string="Unmatch"
                            invisible="state != 'matched'"
                            confirm="Release the bank credit this deposit claimed?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'matched')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'matched')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,validated,matched"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not berita_acara_ref">
                        The store must type this on the transfer memo:
                        <strong><field name="berita_acara_ref" readonly="1" class="oe_inline"/></strong>
                        — it carries the store code, so the bank credit names its own
                        store instead of being guessed at from the narrative.
                    </div>
                    <group>
                        <group string="Store">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="store_code"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Deposit">
                            <field name="deposit_date"/>
                            <field name="amount"/>
                            <field name="bank_journal_id"/>
                            <field name="method"/>
                            <field name="slip_ref"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Takings Covered">
                            <field name="trading_date_from"/>
                            <field name="trading_date_to"/>
                        </group>
                        <group string="Against the Tills">
                            <field name="expected_amount"/>
                            <field name="variance"
                                   decoration-danger="variance != 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evidence" name="evidence">
                            <p class="text-muted">
                                A deposit is validated by someone vouching for the slip, so
                                validation refuses until there is one attached.
                            </p>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="has_evidence" invisible="1"/>
                        </page>
                        <page string="POS Sessions" name="sessions">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="config_id"/>
                                    <field name="start_at"/>
                                    <field name="stop_at"/>
                                    <field name="cash_register_balance_end_real"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                            <field name="statement_line_id" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_levis_store_cash_deposit_list" model="ir.ui.view">
        <field name="name">levis.store.cash.deposit.list</field>
        <field name="model">levis.store.cash.deposit</field>
        <field name="arch" type="xml">
            <list string="Store Cash Deposits"
                  decoration-success="state == 'matched'"
                  decoration-muted="state == 'cancel'"
                  decoration-warning="state == 'validated'">
                <field name="name"/>
                <field name="deposit_date"/>
                <field name="store_code"/>
                <field name="warehouse_id"/>
                <field name="trading_date_from" optional="hide"/>
                <field name="trading_date_to" optional="hide"/>
                <field name="bank_journal_id"/>
                <field name="amount" sum="Deposited"/>
                <field name="expected_amount" sum="Expected" optional="show"/>
                <field name="variance" sum="Variance" optional="show"/>
                <field name="berita_acara_ref" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'matched'"
                       decoration-warning="state == 'validated'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_levis_store_cash_deposit_search" model="ir.ui.view">
        <field name="name">levis.store.cash.deposit.search</field>
        <field name="model">levis.store.cash.deposit</field>
        <field name="arch" type="xml">
            <search string="Store Cash Deposits">
                <field name="name"/>
                <field name="store_code"/>
                <field name="warehouse_id"/>
                <field name="berita_acara_ref"/>
                <field name="slip_ref"/>
                <filter name="awaiting_bank" string="Awaiting Bank Credit"
                        domain="[('state', '=', 'validated')]"/>
                <filter name="to_validate" string="To Validate"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="has_variance" string="Disagrees With Tills"
                        domain="[('variance', '!=', 0)]"/>
                <filter name="no_store_code" string="Store Has No Code"
                        domain="[('store_code', '=', False)]"/>
                <separator/>
                <filter name="not_cancelled" string="Open"
                        domain="[('state', '!=', 'cancel')]"/>
                <separator/>
                    <filter name="group_store" string="Store"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_bank" string="Bank"
                            context="{'group_by': 'bank_journal_id'}"/>
                    <filter name="group_date" string="Deposit Date"
                            context="{'group_by': 'deposit_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_levis_store_cash_deposit" model="ir.actions.act_window">
        <field name="name">Store Cash Deposits</field>
        <field name="res_model">levis.store.cash.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a store's cash deposit</p>
            <p>Card money names its own store through the acquirer's MID. Cash does not —
               so this document names it instead, and the clearing matches a bank credit
               to the document rather than guessing at the transfer memo.</p>
        </field>
    </record>

    <menuitem id="menu_levis_store_cash_deposit"
              name="Store Cash Deposits"
              parent="account.menu_finance_entries"
              action="action_levis_store_cash_deposit"
              sequence="94"/>
</odoo>
