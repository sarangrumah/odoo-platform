<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Extra payment dimensions on the standalone payment form (Payment #4).
      Memo (native ``memo``) and Reference (native ``payment_reference``) are
      surfaced here alongside the Operating Unit, the two account overrides and
      the Note / Remark fields. The overrides change the posted GL; Note / Remark
      are informational and also print on the Payment Voucher.
    -->
    <record id="view_account_payment_form_levis_extra" model="ir.ui.view">
        <field name="name">account.payment.form.levis.extra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ou_analytic_id"
                       domain="['&amp;', ('plan_id.name', '=', 'Operating Unit'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True}"/>
                <field name="destination_account_id"
                       domain="['&amp;', ('company_ids', 'in', company_id),
                                '|', ('account_type', 'in', ('asset_receivable', 'liability_payable')),
                                     ('l10n_allow_payment_destination', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="l10n_override_outstanding_account_id"
                       options="{'no_create': True}"/>
                <field name="payment_reference"/>
                <field name="l10n_note"/>
                <field name="l10n_remark"/>
            </field>
        </field>
    </record>

    <!--
      Feature #20 on the payment itself. Core computes ``reconciled_bill_ids``
      but only surfaces it as a smart-button count, so checking which bills a
      payment settled meant clicking through. 40 of the 145 reconciled payments
      in prd_levis_begbal settle more than one bill.
    -->
    <record id="view_account_payment_form_levis_bills" model="ir.ui.view">
        <field name="name">account.payment.form.levis.settled.bills</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Bills Settled" invisible="not reconciled_bill_ids">
                    <field name="reconciled_bill_ids" nolabel="1" colspan="2" readonly="1">
                        <list create="false" delete="false">
                            <field name="name" string="Bill No"/>
                            <field name="invoice_date" string="Bill Date"/>
                            <field name="ref" string="Vendor Ref"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_total" string="Total"/>
                            <field name="amount_residual" string="Amount Due"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
