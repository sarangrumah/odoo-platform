<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Feature #9 on the vendor bill FORM. The l10n_purchase_type + operating-unit
      fields already exist on account.move; surface them so a MANUALLY-created
      bill (no PO) can pick Trade / Non-Trade (driving BILL/T vs BILL/NT numbering
      and the payable account) and an Operating Unit (Head Office / Store) for
      per-OU P&L. Everything is scoped to vendor bills / refunds.
    -->
    <record id="view_move_form_levis_trade_ou" model="ir.ui.view">
        <field name="name">account.move.form.levis.trade.ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header fields next to the partner -->
            <field name="partner_id" position="after">
                <field name="l10n_purchase_type"
                       widget="radio"
                       options="{'horizontal': True}"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="l10n_ou_analytic_id"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       domain="['&amp;', ('plan_id.name', '=', 'Operating Unit'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True}"/>
            </field>

            <!-- Operating-Unit column on the bill line grid -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="l10n_ou_analytic_id"
                       optional="show"
                       domain="['&amp;', ('plan_id.name', '=', 'Operating Unit'), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                       options="{'no_create': True}"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <!--
      Feature #10 + #12 on the vendor bill LIST and SEARCH panel.

      #10: core ships Draft / Posted / Cancelled as the only status filters
      (`state`), so a bill that is Paid or Reversed cannot be filtered at all:
      305 paid and 3 reversed bills in prd_levis_begbal were unreachable. The
      missing dimension is `payment_state`, added here as three filters plus a
      group-by, kept separate from the existing `state` filters because a bill
      is both Posted AND Paid.

      #12: the Operating Unit (store) already lives on account.move but only on
      the form, so Accounting could not filter or group the bill list per store.
    -->
    <record id="view_account_invoice_filter_levis" model="ir.ui.view">
        <field name="name">account.move.search.levis.status.ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ou_analytic_id"/>
            </field>
            <filter name="cancel" position="after">
                <separator/>
                <filter name="l10n_paid" string="Paid"
                        domain="[('payment_state', '=', 'paid')]"/>
                <filter name="l10n_partial" string="Partially Paid"
                        domain="[('payment_state', '=', 'partial')]"/>
                <filter name="l10n_reversed" string="Reversed"
                        domain="[('payment_state', '=', 'reversed')]"/>
            </filter>
            <filter name="status" position="after">
                <filter name="l10n_group_payment_state" string="Payment Status"
                        context="{'group_by': 'payment_state'}"/>
                <filter name="l10n_group_ou" string="Operating Unit"
                        context="{'group_by': 'l10n_ou_analytic_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_invoice_tree_levis_ou" model="ir.ui.view">
        <field name="name">account.move.list.levis.ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!--
              Anchored on ``ref``: the list carries
              ``invoice_partner_display_name`` TWICE (one variant per move type,
              each column_invisible on the other), so a partner anchor is
              ambiguous, and there is no bare ``partner_id`` to attach to.
            -->
            <field name="ref" position="after">
                <field name="l10n_ou_analytic_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
