<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_levis_pos_clearing_form" model="ir.ui.view">
        <field name="name">levis.pos.clearing.form</field>
        <field name="model">levis.pos.clearing</field>
        <field name="arch" type="xml">
            <form string="Monthly POS Clearing">
                <header>
                    <button name="action_compute" type="object" string="Compute Summary"
                            class="btn-primary" invisible="state not in ('draft', 'computed')"
                            help="Reads the statements and builds the summary below. Creates no journal entry and changes nothing."/>
                    <button name="action_generate_moves" type="object"
                            string="Prepare Entries" class="btn-primary"
                            invisible="state != 'computed'"
                            help="Writes down every journal item this clearing intends to book, on the Planned Entries tab. Still changes no accounting."/>
                    <button name="action_post" type="object"
                            string="Post &amp; Reconcile" class="btn-primary"
                            invisible="state != 'generated'"
                            confirm="This writes the planned items onto the bank statement lines and reconciles the receivables they settle. Undoing it afterwards means Undo Reconciliation on each statement line. Continue?"/>
                    <button name="action_open_mapping_wizard" type="object"
                            string="Map Unmapped Settlements"
                            invisible="unmapped_count == 0"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('computed', 'generated')"/>
                    <button name="action_view_lines" type="object"
                            string="Search Settlements" invisible="state == 'draft'"
                            help="The same settlements as the tab below, in a list you can filter, search and group."/>
                    <button name="action_view_receipts" type="object"
                            string="Receipt Matching" invisible="state not in ('computed', 'generated')"/>
                    <button name="action_view_moves" type="object"
                            string="Journal Entries" invisible="move_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,generated,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="period_ref" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="config_id"/>
                        </group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"
                                   groups="base.group_no_one"/>
                            <field name="bank_journal_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                            <field name="ar_fallback" readonly="state not in ('draft', 'computed')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_count" invisible="1"/>
                            <field name="leg_count" invisible="1"/>
                        </group>
                    </group>

                    <group string="Settlement Totals" invisible="state == 'draft'">
                        <group>
                            <field name="total_gross"/>
                            <field name="total_mdr"/>
                            <field name="total_cash_in"/>
                        </group>
                        <group>
                            <field name="total_allocated"/>
                            <field name="total_short"/>
                            <field name="block_a_total" string="Block A — settlements"/>
                            <field name="block_b_total" string="Block B — prior-month AR"/>
                            <field name="block_c_total" string="Block C — sweep &amp; charges"/>
                        </group>
                    </group>

                    <!-- Everything that could not be settled is stated up front. -->
                    <div class="alert alert-danger" role="alert"
                         invisible="unparsed_count == 0 and unmapped_count == 0 and mismatch_count == 0 and consumed_elsewhere_count == 0">
                        <strong>These lines cannot be booked as they stand.</strong>
                        <ul>
                            <li invisible="unparsed_count == 0">
                                <field name="unparsed_count" class="oe_inline" readonly="1"/>
                                statement line(s) whose narrative could not be read
                                (<field name="unparsed_amount" class="oe_inline" readonly="1"/>).
                            </li>
                            <li invisible="unmapped_count == 0">
                                <field name="unmapped_count" class="oe_inline" readonly="1"/>
                                settlement(s) whose MID, terminal or wording is not mapped to a store
                                (<field name="unmapped_amount" class="oe_inline" readonly="1"/>).
                            </li>
                            <li invisible="mismatch_count == 0">
                                <field name="mismatch_count" class="oe_inline" readonly="1"/>
                                line(s) where the narrative disagrees with the money the bank moved.
                            </li>
                            <li invisible="consumed_elsewhere_count == 0">
                                <field name="consumed_elsewhere_count" class="oe_inline" readonly="1"/>
                                statement line(s) already used by another clearing run.
                            </li>
                        </ul>
                        Their money stays on suspense. Map or fix them and press Compute
                        again, or tick <em>Ignore warnings</em> to book the rest deliberately.
                        <field name="ignore_warnings"/>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="short_count == 0 and missing_day_count == 0 and no_analytic_count == 0 and derived_date_count == 0">
                        <ul>
                            <li invisible="short_count == 0">
                                <field name="short_count" class="oe_inline" readonly="1"/>
                                settlement(s) found no open receivable to settle in full —
                                the remainder stays on suspense (see Diagnostics).
                            </li>
                            <li invisible="missing_day_count == 0">
                                <field name="missing_day_count" class="oe_inline" readonly="1"/>
                                trading day(s) have no statement line although the days
                                around them do — the bank import may have stopped halfway.
                            </li>
                            <li invisible="no_analytic_count == 0">
                                <field name="no_analytic_count" class="oe_inline" readonly="1"/>
                                posted POS receivable line(s) carry no Operating Unit
                                (<field name="no_analytic_amount" class="oe_inline" readonly="1"/>),
                                so no settlement can ever reach them.
                            </li>
                            <li invisible="derived_date_count == 0">
                                <field name="derived_date_count" class="oe_inline" readonly="1"/>
                                settlement(s) carried no transaction date, so their trading
                                day was inferred. The store and the account are still exact.
                            </li>
                        </ul>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not warning_text">
                        <field name="warning_text" nolabel="1" readonly="1"/>
                    </div>

                    <notebook invisible="state == 'draft'">
                        <page string="Settlements" name="block_a">
                            <!-- Not readonly as a whole: the receipt ticks live inside this
                                 form, and a readonly x2many makes every field under it
                                 readonly too. Everything the clearing itself computes is
                                 marked readonly field by field instead. -->
                            <field name="line_ids" domain="[('block', '=', 'a')]"
                                   readonly="state not in ('computed', 'generated')"
                                   context="{'default_block': 'a'}">
                                <list create="false" delete="false" default_order="analytic_account_id, settlement_date">
                                    <field name="analytic_account_id"/>
                                    <field name="settlement_date"/>
                                    <field name="trans_date"/>
                                    <field name="trans_date_is_derived" optional="show"/>
                                    <field name="bank_journal_id"/>
                                    <field name="move_name"/>
                                    <field name="channel"/>
                                    <field name="x24_trans_refs" string="X24DN Transactions"/>
                                    <field name="x24_match" widget="badge" optional="show"
                                           decoration-success="x24_match in ('exact', 'batch')"
                                           decoration-warning="x24_match == 'ambiguous'"
                                           decoration-muted="x24_match == 'none'"/>
                                    <field name="x24_tender" optional="hide"/>
                                    <field name="x24_tender_mismatch" optional="show"
                                           string="Tender Disagrees"/>
                                    <field name="x24_trans_count" optional="hide"/>
                                    <field name="match_gap" optional="hide" sum="Unmatched"/>
                                    <field name="gross" sum="Gross"/>
                                    <field name="mdr" sum="MDR"/>
                                    <field name="cash_in" sum="Cash in"/>
                                    <field name="allocated" sum="Allocated"/>
                                    <field name="short_amount" sum="Short"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'ok'"
                                           decoration-warning="state == 'short'"
                                           decoration-danger="state in ('unmapped', 'unparsed', 'mismatch')"/>
                                    <button name="action_open_receipts" type="object"
                                            string="Match" icon="fa-check-square-o"
                                            title="Tick the transactions this bank line paid for"/>
                                    <field name="payment_ref" optional="hide"/>
                                    <field name="mid_key" optional="hide"/>
                                    <field name="tid_key" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prior-Month AR" name="block_b">
                            <field name="line_ids" readonly="1" domain="[('block', '=', 'b')]">
                                <list create="false" delete="false">
                                    <field name="analytic_account_id"/>
                                    <field name="settlement_date"/>
                                    <field name="bank_journal_id"/>
                                    <field name="move_name"/>
                                    <field name="gross" sum="Gross"/>
                                    <field name="mdr" sum="MDR"/>
                                    <field name="allocated" sum="Allocated"/>
                                    <field name="short_amount" sum="Short"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sweep &amp; Charges" name="block_c">
                            <field name="line_ids" readonly="1" domain="[('block', '=', 'c')]">
                                <list create="false" delete="false">
                                    <field name="settlement_date"/>
                                    <field name="bank_journal_id"/>
                                    <field name="kind"/>
                                    <field name="statement_amount" sum="Amount"/>
                                    <field name="payment_ref"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Not Booked" name="unbooked">
                            <field name="line_ids" readonly="1"
                                   domain="[('state', 'in', ('unmapped', 'unparsed', 'mismatch', 'skipped'))]">
                                <list create="false" delete="false">
                                    <field name="settlement_date"/>
                                    <field name="bank_journal_id"/>
                                    <field name="kind"/>
                                    <field name="state" widget="badge" decoration-danger="1"/>
                                    <field name="statement_amount" sum="Amount"/>
                                    <field name="payment_ref"/>
                                    <field name="note"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Planned Entries" name="legs"
                              invisible="leg_count == 0">
                            <div class="alert alert-info" role="alert">
                                These are the journal items that will be written onto the
                                bank statement lines themselves, replacing their suspense
                                leg. A settlement that is fully explained leaves no
                                suspense leg at all and Odoo marks the line reconciled;
                                anything still on suspense here is the part nobody could
                                account for, and that line stays open by that amount.
                            </div>
                            <field name="leg_ids" readonly="1">
                                <list create="false" delete="false" default_group_by="role">
                                    <field name="settlement_date"/>
                                    <field name="bank_journal_id"/>
                                    <field name="role" widget="badge"
                                           decoration-warning="role == 'short'"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="balance" sum="Balance"/>
                                    <field name="move_line_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Diagnostics" name="diagnostics">
                            <field name="diag_ids" readonly="1">
                                <list create="false" delete="false" default_group_by="kind">
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'blocking'"
                                           decoration-warning="severity == 'warning'"
                                           decoration-info="severity == 'info'"/>
                                    <field name="kind"/>
                                    <field name="date"/>
                                    <field name="bank_journal_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="amount" sum="Amount"/>
                                    <field name="count" sum="Lines"/>
                                    <field name="message"/>
                                    <button name="action_open_record" type="object"
                                            icon="fa-external-link" title="Open the record"
                                            invisible="not res_id"/>
                                    <field name="res_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Balance Check" name="balances">
                            <p class="text-muted">
                                <em>After (simulated)</em> is what posting these entries would
                                produce; <em>After (actual)</em> is filled once they are posted.
                                A difference between the two is reported above, not absorbed.
                            </p>
                            <group>
                                <group string="Bank Suspense">
                                    <field name="bal_suspense_before" string="Before"/>
                                    <field name="bal_suspense_after_sim" string="After (simulated)"/>
                                    <field name="bal_suspense_after_actual" string="After (actual)"/>
                                </group>
                                <group string="MDR Expense">
                                    <field name="bal_mdr_before" string="Before"/>
                                    <field name="bal_mdr_after_sim" string="After (simulated)"/>
                                    <field name="bal_mdr_after_actual" string="After (actual)"/>
                                </group>
                                <group string="Trade Receivable">
                                    <field name="bal_ar_before" string="Before"/>
                                    <field name="bal_ar_after_sim" string="After (simulated)"/>
                                    <field name="bal_ar_after_actual" string="After (actual)"/>
                                </group>
                                <group string="POS Receivable Still Open">
                                    <field name="posrec_open_before" string="Before"/>
                                    <field name="posrec_lines_before" string="Lines before"/>
                                    <field name="posrec_open_after_sim" string="After (simulated)"/>
                                    <field name="posrec_open_after_actual" string="After (actual)"/>
                                    <field name="posrec_lines_after_actual" string="Lines after"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Top-level, so the very same form serves the Settlements tab's row popup and
         the standalone searchable list. The clearing owns every figure on it, hence
         readonly field by field rather than on the form. -->
    <record id="view_levis_pos_clearing_line_form" model="ir.ui.view">
        <field name="name">levis.pos.clearing.line.form</field>
        <field name="model">levis.pos.clearing.line</field>
        <field name="arch" type="xml">
                <form string="Settlement">
                    <group>
                        <group>
                            <field name="run_id" readonly="1"/>
                            <field name="run_state" invisible="1"/>
                            <field name="analytic_account_id" readonly="1"/>
                            <field name="map_id" readonly="1"/>
                            <field name="bank_journal_id" readonly="1"/>
                            <field name="move_name" readonly="1"/>
                            <field name="x24_match" readonly="1"/>
                            <field name="x24_trans_count" readonly="1"/>
                            <field name="x24_tender" readonly="1"/>
                            <field name="x24_tender_mismatch" readonly="1"/>
                            <field name="settlement_date" readonly="1"/>
                            <field name="trans_date" readonly="1"/>
                            <field name="trans_date_is_derived" readonly="1"/>
                        </group>
                        <group>
                            <field name="statement_amount" readonly="1"/>
                            <field name="gross" readonly="1"/>
                            <field name="mdr" readonly="1"/>
                            <field name="mdr_booked" readonly="1"/>
                            <field name="allocated" readonly="1"/>
                            <field name="short_amount" readonly="1"/>
                            <field name="mismatch_amount" readonly="1"/>
                            <field name="matched_total" readonly="1"/>
                            <field name="match_gap" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="payment_ref" readonly="1"/>
                    <field name="note" readonly="1"/>
                    <separator string="X24DN Transactions"/>
                    <div class="text-muted mb-2">
                        Tick the transactions this bank line paid for. Rows are
                        pre-ticked only where the amount proves them — one
                        transaction equal to the settlement, or one tender's whole
                        trading day. A ticked transaction disappears from every
                        other statement line's list, because it is paid once.
                    </div>
                    <button name="action_suggest_receipts" type="object"
                            invisible="run_state not in ('computed', 'generated')"
                            string="Suggest Transactions" class="btn-secondary mb-2"
                            help="Offer this trading day's transactions to tick from. Leaves anything already ticked alone."/>
                    <field name="receipt_ids" nolabel="1" readonly="run_state not in ('computed', 'generated')">
                        <list create="false" delete="false" editable="bottom"
                              default_order="matched desc, trans_date, ref">
                            <field name="matched" widget="boolean_toggle"/>
                            <field name="ref" readonly="1"/>
                            <field name="tender" readonly="1"/>
                            <field name="trans_date" readonly="1"/>
                            <field name="amount" sum="Total" readonly="1"/>
                            <field name="suggested" readonly="1" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="alloc_ids" readonly="1">
                        <list create="false" delete="false">
                            <field name="account_id"/>
                            <field name="source_date"/>
                            <field name="source_aml_id"/>
                            <field name="amount" sum="Allocated"/>
                            <field name="move_line_id" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </form>
        </field>
    </record>

    <record id="view_levis_pos_clearing_receipt_list" model="ir.ui.view">
        <field name="name">levis.pos.clearing.receipt.list</field>
        <field name="model">levis.pos.clearing.receipt</field>
        <field name="arch" type="xml">
            <list string="Receipt Matching" editable="bottom" create="false" delete="false"
                  default_order="move_name, trans_date, ref">
                <header>
                    <button name="action_match" type="object" string="Match Selected"/>
                    <button name="action_unmatch" type="object" string="Unmatch Selected"/>
                </header>
                <field name="matched" widget="boolean_toggle"/>
                <field name="move_name" readonly="1"/>
                <field name="analytic_account_id" readonly="1"/>
                <field name="settlement_date" readonly="1" optional="hide"/>
                <field name="trans_date" readonly="1"/>
                <field name="ref" readonly="1"/>
                <field name="tender" readonly="1"/>
                <field name="amount" sum="Total" readonly="1"/>
                <field name="suggested" readonly="1" optional="show"/>
                <field name="bank_journal_id" readonly="1" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_levis_pos_clearing_receipt_search" model="ir.ui.view">
        <field name="name">levis.pos.clearing.receipt.search</field>
        <field name="model">levis.pos.clearing.receipt</field>
        <field name="arch" type="xml">
            <search string="Receipt Matching">
                <field name="ref"/>
                <field name="move_name"/>
                <field name="analytic_account_id"/>
                <field name="tender"/>
                <filter name="matched" string="Matched" domain="[('matched', '=', True)]"/>
                <filter name="unmatched" string="Not Matched" domain="[('matched', '=', False)]"/>
                <filter name="suggested" string="Proven by Amount" domain="[('suggested', '=', True)]"/>
                <separator/>
                <filter name="group_line" string="Bank Line" context="{'group_by': 'move_name'}"/>
                <filter name="group_store" string="Operating Unit" context="{'group_by': 'analytic_account_id'}"/>
                <filter name="group_day" string="Trading Day" context="{'group_by': 'trans_date'}"/>
                <filter name="group_tender" string="Tender" context="{'group_by': 'tender'}"/>
            </search>
        </field>
    </record>

    <!-- The settlements as first-class records. The Settlements tab can show them
         but never search them: an embedded one2many has no search panel, and a
         month across eleven bank journals is a thousand rows to scroll. -->
    <record id="view_levis_pos_clearing_line_list" model="ir.ui.view">
        <field name="name">levis.pos.clearing.line.list</field>
        <field name="model">levis.pos.clearing.line</field>
        <field name="arch" type="xml">
            <list string="Settlements" create="false" delete="false"
                  default_order="settlement_date, bank_journal_id, id">
                <field name="run_id" optional="hide"/>
                <field name="run_period_ref" optional="hide" string="Period"/>
                <field name="settlement_date"/>
                <field name="trans_date" optional="show"/>
                <field name="trans_date_is_derived" optional="hide"/>
                <field name="analytic_account_id"/>
                <field name="bank_journal_id"/>
                <field name="move_name"/>
                <field name="block" optional="hide"/>
                <field name="kind" optional="hide"/>
                <field name="channel"/>
                <field name="x24_trans_refs" string="X24DN Transactions" optional="show"/>
                <field name="x24_match" widget="badge" optional="show"
                       decoration-success="x24_match in ('exact', 'batch')"
                       decoration-warning="x24_match == 'ambiguous'"
                       decoration-muted="x24_match == 'none'"/>
                <field name="x24_tender" optional="hide"/>
                <field name="x24_tender_mismatch" optional="hide" string="Tender Disagrees"/>
                <field name="statement_amount" sum="Bank" optional="hide"/>
                <field name="gross" sum="Gross"/>
                <field name="mdr" sum="MDR"/>
                <field name="cash_in" sum="Cash in" optional="hide"/>
                <field name="allocated" sum="Allocated"/>
                <field name="short_amount" sum="Short"/>
                <field name="match_gap" sum="Unmatched" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ok'"
                       decoration-warning="state == 'short'"
                       decoration-danger="state in ('unmapped', 'unparsed', 'mismatch')"/>
                <field name="payment_ref" optional="hide"/>
                <field name="mid_key" optional="hide"/>
                <field name="tid_key" optional="hide"/>
                <field name="run_state" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_levis_pos_clearing_line_search" model="ir.ui.view">
        <field name="name">levis.pos.clearing.line.search</field>
        <field name="model">levis.pos.clearing.line</field>
        <field name="arch" type="xml">
            <search string="Settlements">
                <field name="payment_ref" string="Narrative"
                       filter_domain="['|', '|', '|', ('payment_ref', 'ilike', self), ('move_name', 'ilike', self), ('mid_key', 'ilike', self), ('tid_key', 'ilike', self)]"/>
                <field name="move_name" string="Bank Entry No."/>
                <field name="analytic_account_id" string="Operating Unit"/>
                <field name="bank_journal_id" string="Bank"/>
                <field name="x24_trans_refs" string="X24DN Transaction"/>
                <field name="mid_key" string="MID"/>
                <field name="tid_key" string="Terminal"/>
                <field name="run_id" string="Clearing Run"/>
                <field name="settlement_date"/>

                <filter name="state_ok" string="Settled" domain="[('state', '=', 'ok')]"/>
                <filter name="state_short" string="Short" domain="[('short_amount', '&gt;', 0)]"/>
                <filter name="state_unmapped" string="Unmapped" domain="[('state', '=', 'unmapped')]"/>
                <filter name="state_unparsed" string="Unparsed" domain="[('state', '=', 'unparsed')]"/>
                <filter name="not_booked" string="Not Booked"
                        domain="[('state', 'in', ('unmapped', 'unparsed', 'mismatch', 'skipped'))]"/>
                <separator/>
                <filter name="unmatched_receipts" string="Receipts Not Proven"
                        domain="[('x24_match', 'in', ('ambiguous', 'none'))]"/>
                <filter name="tender_disagrees" string="Tender Disagrees"
                        domain="[('x24_tender_mismatch', '=', True)]"/>
                <filter name="derived_date" string="Trading Day Inferred"
                        domain="[('trans_date_is_derived', '=', True)]"/>
                <separator/>
                <filter name="block_a" string="Settlements" domain="[('block', '=', 'a')]"/>
                <filter name="block_b" string="Prior-Month AR" domain="[('block', '=', 'b')]"/>
                <filter name="block_c" string="Sweep &amp; Charges" domain="[('block', '=', 'c')]"/>
                <separator/>
                <filter name="run_open" string="Run Not Posted"
                        domain="[('run_state', 'not in', ('posted', 'cancel'))]"/>
                <separator/>
                <filter name="settlement_month" string="Settlement Date" date="settlement_date"/>
                <separator/>
                <filter name="group_store" string="Operating Unit"
                        context="{'group_by': 'analytic_account_id'}"/>
                <filter name="group_bank" string="Bank" context="{'group_by': 'bank_journal_id'}"/>
                <filter name="group_channel" string="Tender / Channel" context="{'group_by': 'channel'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_block" string="Block" context="{'group_by': 'block'}"/>
                <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                <filter name="group_match" string="Receipt Match" context="{'group_by': 'x24_match'}"/>
                <filter name="group_settlement" string="Settlement Date"
                        context="{'group_by': 'settlement_date'}"/>
                <filter name="group_trans" string="Trading Day" context="{'group_by': 'trans_date'}"/>
                <filter name="group_run" string="Clearing Run" context="{'group_by': 'run_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_levis_pos_clearing_line" model="ir.actions.act_window">
        <field name="name">POS Settlements</field>
        <field name="res_model">levis.pos.clearing.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_run_open': 1, 'search_default_group_store': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No settlement matches this filter</p>
            <p>Every bank line a clearing run read, searchable across runs: by store,
               by bank, by tender, by merchant id, by narrative, or by X24DN
               transaction number.</p>
        </field>
    </record>

    <record id="view_levis_pos_clearing_list" model="ir.ui.view">
        <field name="name">levis.pos.clearing.list</field>
        <field name="model">levis.pos.clearing</field>
        <field name="arch" type="xml">
            <list string="Monthly POS Clearing">
                <field name="name"/>
                <field name="period_ref"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_gross" sum="Gross"/>
                <field name="total_allocated" sum="Allocated"/>
                <field name="total_short" sum="Short"/>
                <field name="unparsed_count" string="Unparsed"/>
                <field name="unmapped_count" string="Unmapped"/>
                <field name="move_count" string="Entries"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state in ('computed', 'generated')"
                       decoration-muted="state == 'cancel'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_levis_pos_clearing_search" model="ir.ui.view">
        <field name="name">levis.pos.clearing.search</field>
        <field name="model">levis.pos.clearing</field>
        <field name="arch" type="xml">
            <search string="POS Clearing">
                <field name="name"/>
                <field name="period_ref"/>
                <field name="bank_journal_ids" string="Bank"/>
                <field name="date_from"/>
                <filter name="not_posted" string="Not Posted"
                        domain="[('state', 'not in', ('posted', 'cancel'))]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="has_short" string="Has Shortfall"
                        domain="[('line_ids.short_amount', '>', 0)]"/>
                <filter name="has_unmapped" string="Has Unmapped"
                        domain="[('line_ids.state', '=', 'unmapped')]"/>
                <filter name="has_unparsed" string="Has Unparsed"
                        domain="[('line_ids.state', '=', 'unparsed')]"/>
                <separator/>
                <filter name="period" string="Period" date="date_from"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_period" string="Period" context="{'group_by': 'period_ref'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_levis_pos_clearing" model="ir.actions.act_window">
        <field name="name">POS Clearing</field>
        <field name="res_model">levis.pos.clearing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Clear a month's POS receivables</p>
            <p>Reads the bank statements already imported for the period, takes the
               gross and the acquirer fee straight from each settlement's narrative,
               and works out which per-tender receivable it pays by consuming that
               store's open debits for the trading day.</p>
            <p>Three steps, in order: <b>Compute</b> shows you the summary and changes
               nothing; <b>Generate Draft Entries</b> writes entries you can read before
               they count; <b>Post &amp; Reconcile</b> commits them. Anything that could
               not be matched is listed rather than absorbed.</p>
        </field>
    </record>

    <menuitem id="menu_levis_pos_clearing_line"
              name="POS Settlements"
              parent="account.menu_finance_entries"
              action="action_levis_pos_clearing_line"
              sequence="93"/>

    <menuitem id="menu_levis_pos_clearing"
              name="POS Clearing"
              parent="account.menu_finance_entries"
              action="action_levis_pos_clearing"
              sequence="92"/>
</odoo>
