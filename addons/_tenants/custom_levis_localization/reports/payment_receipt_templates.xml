<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Receipt: customer / inbound payments. Reuses the shared
         document body defined in payment_voucher_templates.xml. -->
    <template id="report_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="doc_title">PAYMENT RECEIPT</t>
                    <t t-call="custom_levis_localization.report_payment_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
