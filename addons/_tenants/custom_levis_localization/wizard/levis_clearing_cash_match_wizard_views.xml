<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_levis_clearing_cash_match_form" model="ir.ui.view">
        <field name="name">levis.clearing.cash.match.form</field>
        <field name="model">levis.clearing.cash.match</field>
        <field name="arch" type="xml">
            <form string="Match Cash Deposits">
                <header>
                    <button name="action_apply" type="object" string="Pasangkan Setoran"
                            class="btn-primary"
                            help="Record that the ticked credits pay this trading day's till, then recompute the run so they are allocated."/>
                </header>
                <sheet>
                    <field name="store_day_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="ties" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="analytic_account_id" readonly="1"/></h1>
                        <h3 class="text-muted">
                            till of <field name="trading_date" class="oe_inline" readonly="1"/>
                        </h3>
                    </div>

                    <div class="alert alert-success" role="alert" invisible="not ties">
                        The ticked credits are exactly the till still out.
                        Press <b>Pasangkan Setoran</b> to record it and recompute.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="ties or selected_total == 0">
                        Ticked <field name="selected_total" class="oe_inline" widget="monetary" readonly="1"/>
                        against <field name="outstanding" class="oe_inline" widget="monetary" readonly="1"/>
                        still out — difference <field name="gap" class="oe_inline" widget="monetary" readonly="1"/>.
                        A shop may bank one till in two goes, so a part answer is still worth recording.
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="selected_total != 0">
                        These are the bank credits of this run that read as a cash deposit and name
                        no store at all. Tick the one that pays this shop's till of
                        <field name="trading_date" class="oe_inline" readonly="1"/>. Recording it
                        recomputes the run, which is what actually allocates the money.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="outstanding != 0">
                        Nothing of this trading day's till is still out. Anything ticked here would
                        be paying a till that is already banked.
                    </div>

                    <group>
                        <group string="The Till (H-1)">
                            <field name="x70d_cash_total"/>
                            <field name="cash_deposit_total"/>
                            <field name="outstanding"/>
                        </group>
                        <group string="Ticked">
                            <field name="selected_total"/>
                            <field name="gap"/>
                        </group>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list string="Unattributed cash deposits" create="false" delete="false"
                              editable="bottom">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="date" readonly="1"/>
                            <field name="move_name" readonly="1"/>
                            <field name="journal_id" readonly="1" optional="hide"/>
                            <field name="payment_ref" readonly="1"/>
                            <field name="amount" sum="Amount" readonly="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted" colspan="2">
                        A credit only appears here while it belongs to nobody. One the narrative
                        placed, or one already matched by amount, is already on its store's row.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
