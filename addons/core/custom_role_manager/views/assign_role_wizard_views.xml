<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_custom_security_role_assign_form" model="ir.ui.view">
            <field name="name">custom.security.role.assign.form</field>
            <field name="model">custom.security.role.assign</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="mode" widget="radio"/>
                        <field name="role_ids" widget="many2many_tags"
                               options="{'no_quick_create': True}"/>
                        <field name="user_ids" widget="many2many_tags"
                               options="{'no_quick_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_custom_security_role_assign" model="ir.actions.act_window">
            <field name="name">Assign Roles</field>
            <field name="res_model">custom.security.role.assign</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="base.model_res_users"/>
            <field name="binding_view_types">list</field>
            <field name="group_ids" eval="[(4, ref('custom_role_manager.group_role_manager'))]"/>
        </record>
    </data>
</odoo>
