<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_custom_security_role_list" model="ir.ui.view">
            <field name="name">custom.security.role.list</field>
            <field name="model">custom.security.role</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="role_domain"/>
                    <field name="level"/>
                    <field name="scope"/>
                    <field name="user_count" string="Users"/>
                    <field name="is_seed" optional="show"/>
                    <field name="customized" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_custom_security_role_form" model="ir.ui.view">
            <field name="name">custom.security.role.form</field>
            <field name="model">custom.security.role</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_reapply" type="object" string="Re-apply to Users"
                                class="btn-primary" invisible="user_count == 0"
                                help="Push this role's current group list onto every user holding it."/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Accounting Supervisor"/></h1>
                            <field name="active" invisible="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="hq_acc_supervisor"/>
                                <field name="role_domain"/>
                                <field name="level"/>
                                <field name="scope"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="company_ids" widget="many2many_tags"
                                       groups="base.group_multi_company"/>
                                <field name="user_count" string="Users holding this role"/>
                                <field name="is_seed" readonly="1"/>
                                <field name="customized" readonly="1"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="not customized">
                            This shipped role has been edited locally, so platform upgrades will
                            no longer refresh its group list.
                        </div>
                        <notebook>
                            <page string="Rights" name="rights">
                                <group>
                                    <field name="implied_role_ids" widget="many2many_tags"
                                           options="{'no_quick_create': True}"/>
                                </group>
                                <field name="group_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </page>
                            <page string="Description" name="description">
                                <field name="description" placeholder="What this position does, and what it deliberately cannot do."/>
                            </page>
                            <page string="Users" name="users">
                                <field name="user_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True}"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_custom_security_role_search" model="ir.ui.view">
            <field name="name">custom.security.role.search</field>
            <field name="model">custom.security.role</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="group_ids"/>
                    <filter name="filter_seed" string="Shipped" domain="[('is_seed','=',True)]"/>
                    <filter name="filter_customized" string="Customized" domain="[('customized','=',True)]"/>
                    <separator/>
                    <filter name="filter_head_office" string="Head Office"
                            domain="[('scope','in',['head_office','both'])]"/>
                    <filter name="filter_retail" string="Retail"
                            domain="[('scope','in',['retail','both'])]"/>
                    <separator/>
                    <filter name="filter_inactive" string="Archived" domain="[('active','=',False)]"/>
                    <group>
                        <filter name="group_by_domain" string="Functional Domain"
                                context="{'group_by': 'role_domain'}"/>
                        <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
                        <filter name="group_by_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_custom_security_role" model="ir.actions.act_window">
            <field name="name">Security Roles</field>
            <field name="res_model">custom.security.role</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_domain': 1}</field>
            <field name="view_id" ref="view_custom_security_role_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Define a role</p>
                <p>A role bundles the access groups of a position — pick the role on the
                   user instead of ticking group checkboxes one by one.</p>
            </field>
        </record>
    </data>
</odoo>
