<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Global rule, but self-neutralising: `ou_is_scoped` is False for
             anyone with no unit assigned (and for the "All Units" group), so
             installing this module restricts nobody until an assignment is
             made. domain_force is evaluated as Python with `user` in scope,
             so a conditional expression is legitimate here. -->
        <record id="rule_operating_unit_scope" model="ir.rule">
            <field name="name">Operating Unit: own units only</field>
            <field name="model_id" ref="model_operating_unit"/>
            <field name="domain_force">
                [('id', 'in', user.ou_allowed_ids.ids)] if user.ou_is_scoped else [(1, '=', 1)]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_operating_unit_company" model="ir.rule">
            <field name="name">Operating Unit: multi-company</field>
            <field name="model_id" ref="model_operating_unit"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
