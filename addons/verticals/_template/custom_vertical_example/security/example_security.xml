<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Own privilege: groups that share one are rendered as a single
             pick-one dropdown on the user form, so sharing it across modules
             makes saving a user silently drop every other module's group. -->
        <record id="res_groups_privilege_vertical_example" model="res.groups.privilege">
            <field name="name">Custom Vertical Example</field>
            <field name="sequence">190</field>
            <field name="category_id" ref="custom_core.module_category_custom_platform"/>
        </record>


        <!--
            User group for Custom Vertical (Example).

            Every module owns its privilege. Groups sharing one privilege are
            a single pick-one dropdown, so a shared privilege makes saving a
            user drop the other modules' groups. The privilege carries the
            Custom Platform category, so the selector still appears next to
            custom_core and the other verticals on the user form.
        -->
        <record id="group_user" model="res.groups">
            <field name="name">Custom Vertical Example / User</field>
            <field name="privilege_id" ref="res_groups_privilege_vertical_example"/>
            <field name="comment">Baseline access to Custom Vertical (Example) features.</field>
        </record>

    </data>
</odoo>
