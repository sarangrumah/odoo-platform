# ----- Secrets & local config -----
.env
.env.local
.env.*.local
.env.bak-*
.secrets/
.claude/
*.pem
*.key
!nginx/certs/.gitkeep
nginx/certs/*
!nginx/certs/.gitkeep
age.key
age.txt
.secrets.dec.yaml

# ----- Runtime data (bind volumes) -----
# Anchored: only top-level /data/ (bind mounts). Without the leading slash,
# the pattern matched every nested `data/` in the tree — including
# `addons/*/data/` — which silently hid module seed files from version
# control and broke `make install` on fresh deployments.
/data/
!/data/.gitkeep

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.coverage
htmlcov/

# ----- Node / frontend tooling (if needed for assets) -----
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts

# ----- Editors -----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
~$*

# ----- Build / dist -----
dist/
build/
*.tgz
*.tar.gz

# ----- Logs -----
*.log
logs/

# ----- Trivy / scan artifacts -----
trivy-results.*
sbom-*.json
sbom-*.xml

# ----- Coretax sertel (encrypted at rest, but never commit) -----
addons/compliance/custom_coretax/data/sertel/*.p12
addons/compliance/custom_coretax/data/sertel/*.pfx

# ----- Generated extract artifacts (reproducible via 01_extract_x101.py) -----
scripts/tenants/levis/out_*.csv

# ----- ARKA-AIM client source extracts (local-only) -----
# Client-supplied working data, not module data: neither manifest loads these and
# no code references them by name. The SEEDS in the same folders -- aim_asset_register.csv,
# opening_balance_*.csv, missing_accounts.csv -- ARE committed, so ignore the four
# files by name rather than the data/ directory, or the module loses its seeds.
addons/_tenants/custom_arka_aim_asset_register/data/asset_register_registered.csv
addons/_tenants/custom_arka_aim_asset_register/data/asset_register_unregistered.csv
addons/_tenants/custom_arka_aim_opening_balance/data/opening_detail_aim.csv
addons/_tenants/custom_arka_aim_opening_balance/data/opening_detail_arka.csv

# ----- Levis raw XStore migration source data (large, local-only) -----
# The "Mentahan" (raw) XStore export + its zip are ~56MB of source data for the
# one-off migration extract. Keep them local; do not bloat git history. The
# reproducible outputs live under scripts/tenants/levis/ (also gitignored above).
docs/projects/levis/Data XStore (Mentahan)*/
docs/projects/levis/Data XStore (Mentahan)*.zip

# Word exports of the architecture docs. The .md files next to them are the
# source of truth; each exported revision is ~1 MB of binary that git can never
# really delete once committed.
docs/*.docx
# The bare `logs/` rule above matches a directory called logs ANYWHERE, which
# silently swallowed the Next.js route for the transaction-log screen. Re-include
# it explicitly: git cannot un-ignore files inside an ignored directory, so the
# directory itself has to be named.
!vas-pmo/src/app/(app)/logs/
