# Copy to .env.local for local development. Never commit the real password.
#
# The role is created by sql/001_cockpit_ro_role.sql and can only reach
# prd_levis_begbal, only for SELECT, only on seventeen tables.

COCKPIT_DB_HOST=postgres
COCKPIT_DB_PORT=5432
COCKPIT_DB_NAME=prd_levis_begbal
COCKPIT_DB_USER=cockpit_ro
COCKPIT_DB_PASSWORD=
COCKPIT_DB_POOL_MAX=8

# --- Authentication ---
# Credentials are checked by Odoo. It must be odoo-front: the public `odoo` runs
# dbfilter ^%d$ and answers "Database not found" for this tenant.
COCKPIT_ODOO_URL=http://odoo-front:8069
# Signs the session cookie. At least 32 characters, or the app refuses to start
# a session — a default here would let anyone forge one.
COCKPIT_SESSION_SECRET=
COCKPIT_SESSION_TTL=43200

# --- Assistant (optional) -----------------------------------------------------
# The mascot's deterministic catalogue needs none of these. Setting
# COCKPIT_AGENT_URL and COCKPIT_AGENT_SECRET enables the Claude fallback for
# questions the catalogue cannot place; without them those get an honest refusal.
COCKPIT_AGENT_URL=http://cockpit-agent:8080
COCKPIT_AGENT_SECRET=
